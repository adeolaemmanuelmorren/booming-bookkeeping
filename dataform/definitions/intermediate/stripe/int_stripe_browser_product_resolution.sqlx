config {
  type: "table",
  description: "Stripe product IDs resolved with the same ordered Stripe keys used by the browser purchase-confirmation proxy.",
  tags: ["intermediate", "stripe", "stripe_kajabi", "payments", "products"],
  assertions: {
    uniqueKey: ["payment_source", "payment_id"],
  },
  bigquery: {
    clusterBy: ["payment_source", "product_resolution_source"],
  },
}

js {
  const { decodedHtml } = require("includes/normalization");
  const { dropPartitionedTableOnce } = require("includes/table_migrations");

  function cleanedStripeProduct(expression) {
    return `nullif(
      trim(
        regexp_replace(
          regexp_replace(
            regexp_replace(
              regexp_replace(
                ${decodedHtml(expression)},
                r'(?i)^trial period for\\s+',
                ''
              ),
              r'(?i)^\\s*\\d+\\s*[×x]\\s*',
              ''
            ),
            r'(?i)\\s*\\(at\\s+\\$[^)]*\\)\\s*$',
            ''
          ),
          r'\\s+',
          ' '
        )
      ),
      ''
    )`;
  }

  function normalizedStripeProduct(expression) {
    return `lower(${cleanedStripeProduct(expression)})`;
  }

  function stripeLineProduct(expression) {
    return `case
      when regexp_contains(
        ${expression},
        r'(?i)(?:^|\\|\\s*)product:\\s*booming bookkeeping mentorship program'
      )
        then regexp_extract(
          ${expression},
          r'(?i)(?:^|\\|\\s*)product:\\s*(booming bookkeeping mentorship program.*)$'
        )
      else ${expression}
    end`;
  }
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


-- Browser parity reference:
-- /Users/adeola/Boom Bookkeeping/cloudflare-workers/reverse-proxy/src/stripe/confirmed-purchases.ts
-- See getLine(), resolveLineProducts(), resolveMetadataProducts(), and resolveProducts().
with payments as (
  select
    'stripe' as payment_source,
    payment_id,
    invoice_id,
    payment_intent_id,
    metadata_products,
    charge_description
  from ${ref("int_stripe_payment_enrichment")}

  union all

  select
    'stripe_kajabi' as payment_source,
    payment_id,
    invoice_id,
    payment_intent_id,
    metadata_products,
    charge_description
  from ${ref("int_stripe_kajabi_payment_enrichment")}
),

kajabi_invoice_lines as (
  select
    coalesce(nullif(trim(unique_id), ''), nullif(trim(id), '')) as line_item_id,
    invoice_id,
    price_id,
    plan_id,
    nullif(trim(description), '') as line_item_description,
    quantity,
    amount as amount_cents
  from `able-folio-499722.stripe_kajabi.invoice_line_item`
  qualify row_number() over (
    partition by coalesce(nullif(trim(unique_id), ''), nullif(trim(id), ''))
    order by _fivetran_synced desc
  ) = 1
),

kajabi_checkout_sessions as (
  select
    id as checkout_session_id,
    payment_intent_id
  from `able-folio-499722.stripe_kajabi.checkout_session`
  qualify row_number() over (
    partition by id
    order by _fivetran_synced desc
  ) = 1
),

kajabi_checkout_lines as (
  select
    id as checkout_line_item_id,
    checkout_session_id,
    price_id,
    nullif(trim(description), '') as line_item_description,
    quantity,
    amount_total as amount_total_cents
  from `able-folio-499722.stripe_kajabi.checkout_session_line_item`
  qualify row_number() over (
    partition by id
    order by _fivetran_synced desc
  ) = 1
),

kajabi_prices as (
  select
    id as price_id,
    product_id
  from `able-folio-499722.stripe_kajabi.price`
  qualify row_number() over (
    partition by id
    order by _fivetran_synced desc
  ) = 1
),

kajabi_plans as (
  select
    id as plan_id,
    product_id
  from `able-folio-499722.stripe_kajabi.plan`
  qualify row_number() over (
    partition by id
    order by _fivetran_synced desc
  ) = 1
),

kajabi_products as (
  select
    id as product_id,
    nullif(trim(name), '') as product_name
  from `able-folio-499722.stripe_kajabi.product`
  qualify row_number() over (
    partition by id
    order by _fivetran_synced desc
  ) = 1
),

line_candidates as (
  select
    'stripe' as payment_source,
    charge_id as payment_id,
    case candidate_source
      when 'invoice_line_item' then 'invoice_line'
      when 'checkout_line_item' then 'checkout_line'
    end as line_source,
    line_item_id,
    coalesce(product_name, line_item_description) as raw_product_name,
    quantity,
    line_amount_cents
  from ${ref("int_stripe_line_item_candidates")}
  where candidate_source in ('invoice_line_item', 'checkout_line_item')

  union all

  select
    'stripe_kajabi' as payment_source,
    payment.payment_id,
    'invoice_line' as line_source,
    line.line_item_id,
    coalesce(product.product_name, line.line_item_description) as raw_product_name,
    line.quantity,
    line.amount_cents as line_amount_cents
  from ${ref("int_stripe_kajabi_payment_enrichment")} payment
  join kajabi_invoice_lines line
    using (invoice_id)
  left join kajabi_prices price
    on price.price_id = line.price_id
  left join kajabi_plans plan
    on plan.plan_id = line.plan_id
  left join kajabi_products product
    on product.product_id = coalesce(price.product_id, plan.product_id)

  union all

  select
    'stripe_kajabi' as payment_source,
    payment.payment_id,
    'checkout_line' as line_source,
    line.checkout_line_item_id as line_item_id,
    coalesce(product.product_name, line.line_item_description) as raw_product_name,
    line.quantity,
    line.amount_total_cents as line_amount_cents
  from ${ref("int_stripe_kajabi_payment_enrichment")} payment
  join kajabi_checkout_sessions session
    using (payment_intent_id)
  join kajabi_checkout_lines line
    using (checkout_session_id)
  left join kajabi_prices price
    on price.price_id = line.price_id
  left join kajabi_products product
    on product.product_id = price.product_id
),

line_counts as (
  select
    payment_source,
    payment_id,
    line_source,
    count(*) as line_count
  from line_candidates
  group by payment_source, payment_id, line_source
),

named_line_candidates as (
  select
    *,
    ${cleanedStripeProduct(stripeLineProduct("raw_product_name"))} as product_name,
    ${normalizedStripeProduct(stripeLineProduct("raw_product_name"))} as content_id
  from line_candidates
),

positive_line_candidates as (
  select
    *,
    countif(line_amount_cents > 0) over (
      partition by payment_source, payment_id, line_source
    ) > 0 as has_positive_line
  from named_line_candidates
  where content_id is not null
),

selected_line_candidates as (
  select *
  from positive_line_candidates
  where not has_positive_line
     or line_amount_cents > 0
  qualify row_number() over (
    partition by payment_source, payment_id, line_source, content_id
    order by line_item_id
  ) = 1
),

line_products as (
  select
    payment_source,
    payment_id,
    line_source,
    array_agg(content_id order by line_item_id) as content_ids,
    array_agg(product_name order by line_item_id) as product_names
  from selected_line_candidates
  group by payment_source, payment_id, line_source
),

fallback_text as (
  select
    *,
    coalesce(
      nullif(trim(metadata_products), ''),
      regexp_extract(
        charge_description,
        r'(?i)(?:^|\|\s*)products?:\s*(.*)'
      )
    ) as product_text
  from payments
),

fallback_parts as (
  select
    payment_source,
    payment_id,
    product_offset,
    ${cleanedStripeProduct("replace(raw_product_name, '__NUMERIC_COMMA__', ',')")} as product_name,
    ${normalizedStripeProduct("replace(raw_product_name, '__NUMERIC_COMMA__', ',')")} as content_id
  from fallback_text
  cross join unnest(
    split(
      regexp_replace(product_text, r'([0-9]),([0-9])', r'\1__NUMERIC_COMMA__\2'),
      ','
    )
  ) as raw_product_name with offset as product_offset
  where product_text is not null
),

selected_fallback_parts as (
  select *
  from fallback_parts
  where content_id is not null
  qualify row_number() over (
    partition by payment_source, payment_id, content_id
    order by product_offset
  ) = 1
),

fallback_products as (
  select
    payment_source,
    payment_id,
    array_agg(content_id order by product_offset) as content_ids,
    array_agg(product_name order by product_offset) as product_names
  from selected_fallback_parts
  group by payment_source, payment_id
),

resolved_arrays as (
  select
    payments.payment_source,
    payments.payment_id,
    case
      when coalesce(invoice_count.line_count, 0) > 0
        and array_length(invoice_products.content_ids) > 0
        then 'invoice_line'
      when coalesce(invoice_count.line_count, 0) = 0
        and array_length(checkout_products.content_ids) > 0
        then 'checkout_line'
      when array_length(fallback_products.content_ids) > 0
        then 'metadata_or_description'
      else 'missing'
    end as product_resolution_source,
    case
      when coalesce(invoice_count.line_count, 0) > 0
        and array_length(invoice_products.content_ids) > 0
        then invoice_products.content_ids
      when coalesce(invoice_count.line_count, 0) = 0
        and array_length(checkout_products.content_ids) > 0
        then checkout_products.content_ids
      when array_length(fallback_products.content_ids) > 0
        then fallback_products.content_ids
      else cast([] as array<string>)
    end as content_ids,
    case
      when coalesce(invoice_count.line_count, 0) > 0
        and array_length(invoice_products.product_names) > 0
        then invoice_products.product_names
      when coalesce(invoice_count.line_count, 0) = 0
        and array_length(checkout_products.product_names) > 0
        then checkout_products.product_names
      when array_length(fallback_products.product_names) > 0
        then fallback_products.product_names
      else cast([] as array<string>)
    end as product_names
  from payments
  left join line_counts invoice_count
    on invoice_count.payment_source = payments.payment_source
   and invoice_count.payment_id = payments.payment_id
   and invoice_count.line_source = 'invoice_line'
  left join line_products invoice_products
    on invoice_products.payment_source = payments.payment_source
   and invoice_products.payment_id = payments.payment_id
   and invoice_products.line_source = 'invoice_line'
  left join line_products checkout_products
    on checkout_products.payment_source = payments.payment_source
   and checkout_products.payment_id = payments.payment_id
   and checkout_products.line_source = 'checkout_line'
  left join fallback_products
    on fallback_products.payment_source = payments.payment_source
   and fallback_products.payment_id = payments.payment_id
)

select
  payment_source,
  payment_id,
  product_resolution_source,
  content_ids[safe_offset(0)] as product_id,
  array_to_string(product_names, ', ') as product_name,
  content_ids,
  product_names
from resolved_arrays
