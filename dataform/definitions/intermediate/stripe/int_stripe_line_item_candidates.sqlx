config {
  type: "table",
  description: "All documented Stripe product signals linked to successful charges, before choosing the best signal.",
  tags: ["intermediate", "stripe", "payments", "products"],
}

with successful_charges as (
  select *
  from ${ref("stg_stripe_charges")}
  where paid is true
    and status = 'succeeded'
),

checkout_candidates as (
  select
    charge.charge_id,
    'checkout_line_item' as candidate_source,
    2 as candidate_priority,
    session.checkout_session_id,
    session.subscription_id,
    session.payment_link_id,
    line.checkout_line_item_id as line_item_id,
    line.price_id,
    cast(null as string) as plan_id,
    price.product_id,
    product.product_name,
    line.description as line_item_description,
    line.quantity,
    line.amount_total_cents as line_amount_cents,
    line.amount_total as line_amount
  from successful_charges as charge
  inner join ${ref("stg_stripe_checkout_sessions")} as session
    on session.payment_intent_id = charge.payment_intent_id
  inner join ${ref("stg_stripe_checkout_session_line_items")} as line
    on line.checkout_session_id = session.checkout_session_id
  left join ${ref("stg_stripe_prices")} as price
    on price.price_id = line.price_id
  left join ${ref("stg_stripe_products")} as product
    on product.product_id = price.product_id
),

invoice_candidates as (
  select
    charge.charge_id,
    'invoice_line_item' as candidate_source,
    3 as candidate_priority,
    cast(null as string) as checkout_session_id,
    coalesce(line.subscription_id, invoice.subscription_id) as subscription_id,
    cast(null as string) as payment_link_id,
    line.invoice_line_item_key as line_item_id,
    line.price_id,
    line.plan_id,
    coalesce(price.product_id, plan.product_id) as product_id,
    product.product_name,
    line.description as line_item_description,
    line.quantity,
    line.amount_cents as line_amount_cents,
    line.amount as line_amount
  from successful_charges as charge
  inner join ${ref("stg_stripe_invoices")} as invoice
    on invoice.invoice_id = charge.invoice_id
  inner join ${ref("stg_stripe_invoice_line_items")} as line
    on line.invoice_id = invoice.invoice_id
  left join ${ref("stg_stripe_prices")} as price
    on price.price_id = line.price_id
  left join ${ref("stg_stripe_plans")} as plan
    on plan.plan_id = line.plan_id
  left join ${ref("stg_stripe_products")} as product
    on product.product_id = coalesce(price.product_id, plan.product_id)
),

subscription_candidates as (
  select
    charge.charge_id,
    'subscription_item' as candidate_source,
    4 as candidate_priority,
    cast(null as string) as checkout_session_id,
    invoice.subscription_id,
    cast(null as string) as payment_link_id,
    item.subscription_item_id as line_item_id,
    case
      when price.price_id is not null then price.price_id
      else cast(null as string)
    end as price_id,
    item.plan_id,
    coalesce(price.product_id, plan.product_id) as product_id,
    product.product_name,
    coalesce(product.product_name, price.nickname, plan.nickname) as line_item_description,
    item.quantity,
    coalesce(price.unit_amount_cents, plan.amount_cents) as line_amount_cents,
    coalesce(price.unit_amount, plan.amount) as line_amount
  from successful_charges as charge
  inner join ${ref("stg_stripe_invoices")} as invoice
    on invoice.invoice_id = charge.invoice_id
  inner join ${ref("stg_stripe_subscription_items")} as item
    on item.subscription_id = invoice.subscription_id
  left join ${ref("stg_stripe_prices")} as price
    on price.price_id = item.plan_id
  left join ${ref("stg_stripe_plans")} as plan
    on plan.plan_id = item.plan_id
  left join ${ref("stg_stripe_products")} as product
    on product.product_id = coalesce(price.product_id, plan.product_id)
),

payment_link_candidates as (
  select
    charge.charge_id,
    'payment_link_line_item' as candidate_source,
    5 as candidate_priority,
    session.checkout_session_id,
    session.subscription_id,
    session.payment_link_id,
    line.payment_link_line_item_id as line_item_id,
    line.price_id,
    cast(null as string) as plan_id,
    price.product_id,
    product.product_name,
    line.description as line_item_description,
    line.quantity,
    line.amount_total_cents as line_amount_cents,
    line.amount_total as line_amount
  from successful_charges as charge
  inner join ${ref("stg_stripe_checkout_sessions")} as session
    on session.payment_intent_id = charge.payment_intent_id
  inner join ${ref("stg_stripe_payment_link_line_items")} as line
    on line.payment_link_id = session.payment_link_id
  left join ${ref("stg_stripe_prices")} as price
    on price.price_id = line.price_id
  left join ${ref("stg_stripe_products")} as product
    on product.product_id = price.product_id
)

select * from checkout_candidates
union all
select * from invoice_candidates
union all
select * from subscription_candidates
union all
select * from payment_link_candidates

