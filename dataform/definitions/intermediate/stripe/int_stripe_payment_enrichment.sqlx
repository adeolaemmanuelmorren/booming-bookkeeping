config {
  type: "table",
  description: "Successful Stripe charges enriched with customer, invoice, Checkout, line-item, product, and discount signals.",
  tags: ["intermediate", "stripe", "payments"],
  bigquery: {
    partitionBy: "DATE(payment_time)",
    clusterBy: ["customer_id", "subscription_id"],
  },
}

with successful_charges as (
  select *
  from ${ref("stg_stripe_charges")}
  where paid is true
    and status = 'succeeded'
),

checkout_session_summary as (
  select
    charge.charge_id,
    (
      array_agg(
        struct(
          session.checkout_session_id,
          session.subscription_id,
          session.payment_link_id,
          session.mode,
          session.payment_status,
          session.discount_amount,
          session.tax_amount,
          session.shipping_amount
        )
        order by session.checkout_session_id
        limit 1
      )
    )[safe_offset(0)] as checkout
  from successful_charges as charge
  inner join ${ref("stg_stripe_checkout_sessions")} as session
    on session.payment_intent_id = charge.payment_intent_id
  group by charge.charge_id
),

candidate_summary as (
  select
    charge_id,
    (
      array_agg(
        struct(
          candidate_source,
          checkout_session_id,
          subscription_id,
          payment_link_id,
          line_item_id,
          product_id,
          product_name,
          price_id,
          plan_id,
          line_item_description,
          quantity,
          line_amount_cents,
          line_amount
        )
        order by
          case when product_id is not null then 0 else 1 end,
          candidate_priority,
          line_item_id
        limit 1
      )
    )[safe_offset(0)] as best_candidate,
    string_agg(distinct line_item_description, ' | ') as line_item_signal,
    logical_or(product_id = 'prod_RtWRamfeN5cGXG') as has_basic_vip_product,
    logical_or(price_id = 'price_1QzjOMBf6i84vTZEJziq3pN7') as has_basic_vip_price,
    logical_or(payment_link_id = 'plink_1QzjOqBf6i84vTZEkOOwnbNJ') as has_basic_vip_payment_link,
    logical_or(product_id = 'prod_RL2UJfDpmvCvRx') as has_krc_product,
    logical_or(price_id = 'price_1QSMPLBf6i84vTZEbLsCt1b7') as has_krc_price,
    logical_or(product_id = 'prod_RlhQH6wdxzjZeZ') as has_full_payment_product,
    logical_or(price_id = 'price_1QsA1wBf6i84vTZEca307VRJ') as has_full_payment_price,
    logical_or(product_id = 'prod_PtzEmmHhC1K9Xi') as has_3x1997_product,
    logical_or(plan_id = 'BBB3X1997' or price_id = 'BBB3X1997') as has_3x1997_plan,
    logical_or(product_id = 'prod_RtWNqT9xux5CI7') as has_balance_product,
    logical_or(price_id = 'price_1QzjKMBf6i84vTZE2WPd5Rh7') as has_balance_price
  from ${ref("int_stripe_line_item_candidates")}
  group by charge_id
)

select
  charge.charge_id as payment_id,
  charge.charge_created_at as payment_time,
  date(charge.charge_created_at, 'America/Los_Angeles') as payment_date,
  charge.customer_id,
  coalesce(
    nullif(lower(trim(charge.billing_detail_email)), ''),
    nullif(lower(trim(charge.receipt_email)), ''),
    customer.email,
    nullif(lower(trim(payment_intent.receipt_email)), '')
  ) as payment_email,
  coalesce(nullif(trim(charge.billing_detail_name), ''), customer.name) as payment_name,
  coalesce(nullif(trim(charge.billing_detail_phone), ''), customer.phone) as payment_phone,
  charge.currency,
  charge.amount_cents,
  charge.amount as amount_paid,
  charge.amount_refunded_cents,
  charge.amount_refunded as refund_amount,
  charge.net_amount,
  charge.amount_refunded_cents > 0 as has_refund,
  charge.payment_intent_id,
  charge.payment_method_id,
  charge.invoice_id,
  coalesce(invoice.subscription_id, checkout.checkout.subscription_id) as subscription_id,
  checkout.checkout.checkout_session_id,
  coalesce(checkout.checkout.payment_link_id, candidate.best_candidate.payment_link_id) as payment_link_id,
  invoice.billing_reason as invoice_billing_reason,
  checkout.checkout.mode as checkout_mode,
  candidate.best_candidate.candidate_source as catalog_source,
  candidate.best_candidate.product_id as catalog_product_id,
  candidate.best_candidate.product_name as catalog_product_name,
  candidate.best_candidate.price_id as catalog_price_id,
  candidate.best_candidate.plan_id as catalog_plan_id,
  candidate.best_candidate.line_item_description as catalog_line_item_description,
  candidate.best_candidate.quantity as catalog_quantity,
  candidate.best_candidate.line_amount as catalog_line_amount,
  candidate.line_item_signal,
  coalesce(candidate.has_basic_vip_product, false) as has_basic_vip_product,
  coalesce(candidate.has_basic_vip_price, false) as has_basic_vip_price,
  coalesce(candidate.has_basic_vip_payment_link, false) as has_basic_vip_payment_link,
  coalesce(candidate.has_krc_product, false) as has_krc_product,
  coalesce(candidate.has_krc_price, false) as has_krc_price,
  coalesce(candidate.has_full_payment_product, false) as has_full_payment_product,
  coalesce(candidate.has_full_payment_price, false) as has_full_payment_price,
  coalesce(candidate.has_3x1997_product, false) as has_3x1997_product,
  coalesce(candidate.has_3x1997_plan, false) as has_3x1997_plan,
  coalesce(candidate.has_balance_product, false) as has_balance_product,
  coalesce(candidate.has_balance_price, false) as has_balance_price,
  coalesce(discount.has_discount, false) as has_discount,
  coalesce(discount.discount_amount_cents, 0) as discount_amount_cents,
  coalesce(discount.discount_amount, 0) as discount_amount,
  coalesce(discount.discount_ids, cast([] as array<string>)) as discount_ids,
  coalesce(discount.coupon_ids, cast([] as array<string>)) as coupon_ids,
  coalesce(discount.coupon_names, cast([] as array<string>)) as coupon_names,
  coalesce(discount.promotion_code_ids, cast([] as array<string>)) as promotion_code_ids,
  coalesce(discount.promotion_codes, cast([] as array<string>)) as promotion_codes,
  discount.coupon_amount_off,
  discount.coupon_percent_off,
  charge.description as charge_description,
  charge.calculated_statement_descriptor,
  charge.statement_descriptor,
  payment_intent.description as payment_intent_description,
  invoice.description as invoice_description,
  lower(concat(
    coalesce(charge.description, ''), ' ',
    coalesce(charge.calculated_statement_descriptor, ''), ' ',
    coalesce(charge.statement_descriptor, ''), ' ',
    coalesce(payment_intent.description, ''), ' ',
    coalesce(invoice.description, ''), ' ',
    coalesce(candidate.line_item_signal, '')
  )) as classification_signal,
  charge.receipt_url,
  charge.livemode
from successful_charges as charge
left join ${ref("stg_stripe_customers")} as customer
  on customer.customer_id = charge.customer_id
left join ${ref("stg_stripe_payment_intents")} as payment_intent
  on payment_intent.payment_intent_id = charge.payment_intent_id
left join ${ref("stg_stripe_invoices")} as invoice
  on invoice.invoice_id = charge.invoice_id
left join checkout_session_summary as checkout
  on checkout.charge_id = charge.charge_id
left join candidate_summary as candidate
  on candidate.charge_id = charge.charge_id
left join ${ref("int_stripe_payment_discounts")} as discount
  on discount.charge_id = charge.charge_id

