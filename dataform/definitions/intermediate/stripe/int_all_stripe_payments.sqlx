config {
  type: "table",
  description: "Common successful-payment contract across the original Stripe and Kajabi Stripe accounts.",
  tags: ["intermediate", "stripe", "stripe_kajabi", "payments"],
  bigquery: {
    clusterBy: ["payment_source", "product_rule", "is_repeat_payment"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const { normalizedProduct } = require("includes/normalization");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with original_stripe as (
  select
    'stripe' as payment_source,
    payment_id,
    payment_time,
    payment_date,
    customer_id,
    payment_email,
    payment_name,
    payment_phone,
    currency,
    amount_paid,
    refund_amount,
    net_amount,
    has_refund,
    product_id,
    product_name,
    product_variant,
    catalog_price_id as price_id,
    catalog_plan_id as plan_id,
    product_rule,
    product_classification_method,
    is_product_classified,
    payment_sequence_number,
    payment_occurrence_type,
    is_repeat_payment,
    payment_intent_id,
    payment_method_id,
    invoice_id,
    subscription_id,
    checkout_session_id,
    payment_link_id,
    invoice_billing_reason,
    checkout_mode,
    has_discount,
    discount_amount,
    discount_ids,
    coupon_ids,
    coupon_names,
    promotion_code_ids,
    promotion_codes,
    coupon_amount_off,
    coupon_percent_off,
    charge_description,
    calculated_statement_descriptor,
    statement_descriptor,
    payment_intent_description,
    invoice_description,
    book_product_text,
    receipt_url,
    livemode,
    coalesce(
      nullif(trim(metadata_products), ''),
      nullif(trim(book_product_text), ''),
      nullif(trim(product_name), '')
    ) as product_complete_name
  from ${ref("int_stripe_payment_occurrence")}
),

kajabi_stripe as (
  select
    'stripe_kajabi' as payment_source,
    payment_id,
    payment_time,
    payment_date,
    customer_id,
    payment_email,
    payment_name,
    payment_phone,
    currency,
    amount_paid,
    refund_amount,
    net_amount,
    has_refund,
    product_id,
    product_name,
    cast(null as string) as product_variant,
    price_id,
    plan_id,
    product_rule,
    product_classification_method,
    is_product_classified,
    payment_sequence_number,
    payment_occurrence_type,
    is_repeat_payment,
    payment_intent_id,
    payment_method_id,
    invoice_id,
    subscription_id,
    cast(null as string) as checkout_session_id,
    cast(null as string) as payment_link_id,
    invoice_billing_reason,
    cast(null as string) as checkout_mode,
    false as has_discount,
    cast(0 as numeric) as discount_amount,
    cast([] as array<string>) as discount_ids,
    cast([] as array<string>) as coupon_ids,
    cast([] as array<string>) as coupon_names,
    cast([] as array<string>) as promotion_code_ids,
    cast([] as array<string>) as promotion_codes,
    cast(null as numeric) as coupon_amount_off,
    cast(null as numeric) as coupon_percent_off,
    charge_description,
    calculated_statement_descriptor,
    statement_descriptor,
    payment_intent_description,
    invoice_description,
    cast(null as string) as book_product_text,
    receipt_url,
    livemode,
    coalesce(nullif(trim(product_name), ''), nullif(trim(complete_line_description), ''))
      as product_complete_name
  from ${ref("int_stripe_kajabi_payment_occurrence")}
),

combined as (
  select * from original_stripe
  union all
  select * from kajabi_stripe
)

select
  *,
  array(
    select normalized_name
    from unnest(
      case
        when product_complete_name is null then cast([] as array<string>)
        else split(
          regexp_replace(
            product_complete_name,
            r'([0-9]),([0-9])',
            r'\1__NUMERIC_COMMA__\2'
          ),
          ','
        )
      end
    ) as raw_name
    cross join unnest([
      ${normalizedProduct("replace(raw_name, '__NUMERIC_COMMA__', ',')")}
    ]) as normalized_name
    where normalized_name is not null
  ) as content_ids
from combined
