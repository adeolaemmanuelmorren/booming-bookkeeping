config {
  type: "table",
  description: "Discount, coupon, and promotion-code context aggregated to successful Stripe charge grain.",
  tags: ["intermediate", "stripe", "payments", "discounts"],
}

with successful_charges as (
  select *
  from ${ref("stg_stripe_charges")}
  where paid is true
    and status = 'succeeded'
),

invoice_discount_links as (
  select
    charge.charge_id,
    discount.discount_id
  from successful_charges as charge
  inner join ${ref("stg_stripe_discounts")} as discount
    on discount.invoice_id = charge.invoice_id
),

checkout_discount_links as (
  select
    charge.charge_id,
    discount.discount_id
  from successful_charges as charge
  inner join ${ref("stg_stripe_checkout_sessions")} as session
    on session.payment_intent_id = charge.payment_intent_id
  inner join ${ref("stg_stripe_discounts")} as discount
    on discount.checkout_session_id = session.checkout_session_id
),

subscription_discount_links as (
  select
    charge.charge_id,
    discount.discount_id
  from successful_charges as charge
  inner join ${ref("stg_stripe_invoices")} as invoice
    on invoice.invoice_id = charge.invoice_id
  inner join ${ref("stg_stripe_discounts")} as discount
    on discount.subscription_id = invoice.subscription_id
),

discount_links as (
  select distinct charge_id, discount_id
  from (
    select * from invoice_discount_links
    union all
    select * from checkout_discount_links
    union all
    select * from subscription_discount_links
  )
),

discount_details as (
  select
    link.charge_id,
    discount.discount_id,
    discount.discount_amount_cents,
    discount.discount_amount,
    discount.coupon_id,
    coupon.coupon_name,
    coupon.amount_off as coupon_amount_off,
    coupon.percent_off as coupon_percent_off,
    discount.promotion_code_id,
    promotion.promotion_code
  from discount_links as link
  inner join ${ref("stg_stripe_discounts")} as discount
    on discount.discount_id = link.discount_id
  left join ${ref("stg_stripe_coupons")} as coupon
    on coupon.coupon_id = discount.coupon_id
  left join ${ref("stg_stripe_promotion_codes")} as promotion
    on promotion.promotion_code_id = discount.promotion_code_id
)

select
  charge_id,
  true as has_discount,
  sum(coalesce(discount_amount_cents, 0)) as discount_amount_cents,
  sum(coalesce(discount_amount, 0)) as discount_amount,
  array_agg(distinct discount_id ignore nulls) as discount_ids,
  array_agg(distinct coupon_id ignore nulls) as coupon_ids,
  array_agg(distinct coupon_name ignore nulls) as coupon_names,
  array_agg(distinct promotion_code_id ignore nulls) as promotion_code_ids,
  array_agg(distinct promotion_code ignore nulls) as promotion_codes,
  max(coupon_amount_off) as coupon_amount_off,
  max(coupon_percent_off) as coupon_percent_off
from discount_details
group by charge_id

