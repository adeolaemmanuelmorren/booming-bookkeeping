config {
  type: "table",
  description: "Stripe payments labeled as one-time, initial, renewal, installment, or balance with repeat-payment flags.",
  tags: ["intermediate", "stripe", "payments"],
  bigquery: {
    partitionBy: "DATE(payment_time)",
    clusterBy: ["customer_id", "subscription_id", "is_repeat_payment"],
  },
}

with sequenced as (
  select
    payment.*,
    case
      when subscription_id is null then cast(null as int64)
      else row_number() over (
        partition by subscription_id
        order by payment_time, payment_id
      )
    end as payment_sequence_number
  from ${ref("int_stripe_payment_product_resolution")} as payment
)

select
  sequenced.*,
  case
    when product_rule = 'mentorship_balance' then 'balance'
    when subscription_id is null then 'one_time'
    when payment_sequence_number = 1 then 'initial'
    when product_rule = 'mentorship_3x1997' then 'installment'
    else 'renewal'
  end as payment_occurrence_type,
  product_rule = 'mentorship_balance'
    or coalesce(payment_sequence_number > 1, false) as is_repeat_payment
from sequenced

