config {
  type: "table",
  description: "Successful Stripe charges classified using the documented product-resolution priority and exact business rules.",
  tags: ["intermediate", "stripe", "payments", "products"],
  bigquery: {
    partitionBy: "DATE(payment_time)",
    clusterBy: ["customer_id", "product_rule"],
  },
}

with signals as (
  select
    payment.*,
    regexp_extract(
      payment.charge_description,
      r'(?i)products?:[[:space:]]*(.*)'
    ) as book_product_text,
    regexp_contains(
      lower(concat(
        coalesce(payment.calculated_statement_descriptor, ''),
        ' ',
        coalesce(payment.statement_descriptor, '')
      )),
      r'keyboard rich book'
    ) as is_keyboard_rich_book,
    payment.amount_cents = 4700
      and regexp_contains(payment.classification_signal, r'(keyboard rich|keyboardrich|krc)')
      and regexp_contains(payment.classification_signal, r'(vip|backstage|basic package|platinum)')
      as is_47_vip,
    payment.amount_cents in (99700, 49700)
      and regexp_contains(
        lower(coalesce(payment.charge_description, '')),
        r'mentorship program \(deposit\)'
      ) as is_mentorship_deposit
  from ${ref("int_stripe_payment_enrichment")} as payment
),

matched as (
  select
    signals.*,
    case
      when is_keyboard_rich_book then 'keyboard_rich_book'
      when has_basic_vip_product or has_basic_vip_price or has_basic_vip_payment_link then 'structured_basic_vip'
      when has_krc_product or has_krc_price then 'structured_keyboard_rich_challenge'
      when is_47_vip then 'keyboard_rich_challenge_vip'
      when is_mentorship_deposit then 'mentorship_deposit'
      when has_full_payment_product or has_full_payment_price then 'mentorship_full_payment'
      when has_3x1997_product or has_3x1997_plan then 'mentorship_3x1997'
      when has_balance_product or has_balance_price then 'mentorship_balance'
      when catalog_product_name is not null then 'catalog_product'
      else 'unclassified'
    end as product_rule
  from signals
),

classified as (
  select
    matched.*,
    case product_rule
      when 'structured_basic_vip' then 'prod_RtWRamfeN5cGXG'
      when 'structured_keyboard_rich_challenge' then 'prod_RL2UJfDpmvCvRx'
      when 'mentorship_full_payment' then 'prod_RlhQH6wdxzjZeZ'
      when 'mentorship_3x1997' then 'prod_PtzEmmHhC1K9Xi'
      when 'mentorship_balance' then 'prod_RtWNqT9xux5CI7'
      when 'catalog_product' then catalog_product_id
      else catalog_product_id
    end as product_id,
    case product_rule
      when 'keyboard_rich_book' then 'Keyboard Rich book'
      when 'structured_basic_vip' then 'KRC - Basic VIP'
      when 'structured_keyboard_rich_challenge' then 'Keyboard Rich Challenge'
      when 'keyboard_rich_challenge_vip' then '$47 Keyboard Rich Challenge VIP'
      when 'mentorship_deposit' then 'Booming Bookkeeping Mentorship Program deposit'
      when 'mentorship_full_payment' then 'Booming Bookkeeping Mentorship Program'
      when 'mentorship_3x1997' then 'Booming Bookkeeping Mentorship Program (3 payments of $1,997)'
      when 'mentorship_balance' then 'Booming Bookkeeping Balance payment'
      when 'catalog_product' then catalog_product_name
      else 'unclassified'
    end as product_name,
    case
      when product_rule != 'keyboard_rich_book' then cast(null as string)
      when regexp_contains(lower(coalesce(book_product_text, '')), r'international shipping')
        and regexp_contains(lower(coalesce(book_product_text, '')), r'audiobook')
        then 'Book + international shipping + audiobook'
      when regexp_contains(lower(coalesce(book_product_text, '')), r'domestic shipping')
        and regexp_contains(lower(coalesce(book_product_text, '')), r'audiobook')
        then 'Book + domestic shipping + audiobook'
      when regexp_contains(lower(coalesce(book_product_text, '')), r'international shipping')
        then 'Book + international shipping'
      when regexp_contains(lower(coalesce(book_product_text, '')), r'domestic shipping')
        then 'Book + domestic shipping'
      when regexp_contains(lower(coalesce(book_product_text, '')), r'audiobook')
        then 'Book + audiobook/no shipping label'
      else 'Book/no shipping label'
    end as product_variant,
    case product_rule
      when 'keyboard_rich_book' then 'charge_statement_descriptor'
      when 'keyboard_rich_challenge_vip' then 'charge_amount_and_text'
      when 'mentorship_deposit' then 'charge_description_and_amount'
      when 'structured_basic_vip' then 'stripe_catalog_or_payment_link'
      when 'structured_keyboard_rich_challenge' then 'stripe_catalog'
      when 'mentorship_full_payment' then 'stripe_catalog'
      when 'mentorship_3x1997' then 'stripe_plan_or_catalog'
      when 'mentorship_balance' then 'stripe_catalog'
      when 'catalog_product' then catalog_source
      else 'unclassified'
    end as product_classification_method,
    product_rule != 'unclassified' as is_product_classified
  from matched
)

select
  classified.* except (
    is_keyboard_rich_book,
    is_47_vip,
    is_mentorship_deposit,
    has_basic_vip_product,
    has_basic_vip_price,
    has_basic_vip_payment_link,
    has_krc_product,
    has_krc_price,
    has_full_payment_product,
    has_full_payment_price,
    has_3x1997_product,
    has_3x1997_plan,
    has_balance_product,
    has_balance_price
  )
from classified

