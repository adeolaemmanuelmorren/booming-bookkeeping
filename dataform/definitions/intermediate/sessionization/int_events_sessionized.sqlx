config {
  type: "table",
  description: "Segment page views grouped into browser sessions using a 30-minute inactivity cutoff.",
  tags: ["intermediate", "sessionization"],
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with ordered as (
  select
    *,
    coalesce(anonymous_id, user_id, page_view_id) as visitor_key,
    lag(page_view_timestamp) over (
      partition by coalesce(anonymous_id, user_id, page_view_id)
      order by page_view_timestamp, page_view_id
    ) as previous_page_view_timestamp
  from ${ref("stg_page_views")}
  where page_view_timestamp is not null
),

flagged as (
  select
    *,
    previous_page_view_timestamp is null
      or timestamp_diff(page_view_timestamp, previous_page_view_timestamp, minute) > 30
      as starts_new_session
  from ordered
),

numbered as (
  select
    *,
    countif(starts_new_session) over (
      partition by visitor_key
      order by page_view_timestamp, page_view_id
      rows between unbounded preceding and current row
    ) as visitor_session_number
  from flagged
)

select
  *,
  to_hex(md5(concat(visitor_key, '|', cast(visitor_session_number as string)))) as session_id
from numbered
