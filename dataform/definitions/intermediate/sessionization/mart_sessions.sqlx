config {
  type: "table",
  description: "Session-level rollup of Boom page views and marketing parameters.",
  tags: ["intermediate", "sessionization"],
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with ranked as (
  select
    *,
    row_number() over (
      partition by session_id
      order by page_view_timestamp, page_view_id
    ) as first_rank,
    row_number() over (
      partition by session_id
      order by page_view_timestamp desc, page_view_id desc
    ) as last_rank
  from ${ref("int_events_sessionized")}
),

first_events as (
  select * from ranked where first_rank = 1
),

last_events as (
  select * from ranked where last_rank = 1
),

counts as (
  select session_id, count(*) as page_view_count
  from ranked
  group by session_id
),

meta_ad_lookup as (
  select
    campaign_id,
    adset_id,
    ad_id
  from ${ref("stg_facebook_ads")}
  qualify row_number() over (
    partition by adset_id, ad_id
    order by time desc, campaign_id
  ) = 1
)

select
  first_events.session_id,
  first_events.visitor_key,
  first_events.anonymous_id,
  first_events.user_id,
  first_events.page_view_timestamp as session_start_timestamp,
  last_events.page_view_timestamp as session_end_timestamp,
  timestamp_diff(last_events.page_view_timestamp, first_events.page_view_timestamp, second)
    as session_duration_seconds,
  counts.page_view_count,
  first_events.page_view_id as first_page_view_id,
  first_events.page_url as first_page_url,
  first_events.page_host as first_page_host,
  first_events.page_path as first_page_path,
  first_events.page_path_host as first_page_path_host,
  first_events.ip_address,
  first_events.user_agent,
  first_events.device_platform,
  first_events.device_is_mobile,
  first_events.geo_city,
  first_events.geo_region,
  first_events.geo_region_code,
  first_events.geo_country,
  first_events.geo_timezone,
  last_events.page_view_id as last_page_view_id,
  last_events.page_url as last_page_url,
  last_events.page_path as last_page_path,
  first_events.utm_source,
  first_events.utm_medium,
  first_events.utm_campaign,
  first_events.utm_content,
  first_events.utm_term,
  first_events.utm_id,
  coalesce(first_events.campaign_id, meta_ad_lookup.campaign_id) as campaign_id,
  first_events.adset_id,
  first_events.ad_id,
  first_events.google_keyword_id,
  first_events.google_keyword,
  first_events.click_id,
  first_events.click_id_type,
  first_events.gclid,
  first_events.gbraid,
  first_events.wbraid,
  first_events.fbclid,
  first_events.ttclid,
  first_events.li_fat_id,
  first_events.rdt_cid,
  first_events.twclid,
  first_events.fbc,
  first_events.fbp,
  first_events.ttp,
  first_events.uetsid,
  first_events.uetvid,
  first_events.channel_source,
  first_events.channel_medium
from first_events
join last_events using (session_id)
join counts using (session_id)
left join meta_ad_lookup
  on first_events.utm_source = 'meta'
 and first_events.adset_id = meta_ad_lookup.adset_id
 and first_events.ad_id = meta_ad_lookup.ad_id
