config {
  type: "table",
  description: "Kajabi Stripe payments classified by product and sequenced within real subscriptions.",
  tags: ["intermediate", "stripe_kajabi", "payments"],
  bigquery: {
    clusterBy: ["product_rule", "is_repeat_payment"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with classified as (
  select
    payment.*,
    case
      when plan_id = 'subscription_plan_2149288216'
        or regexp_contains(lower(coalesce(line_item_description, '')), r'booming bookkeeping mentorship program')
        then 'kajabi_mentorship_monthly'
      when plan_id = 'subscription_plan_255477'
        or regexp_contains(lower(coalesce(line_item_description, '')), r'booming bookkeeping business.*installment')
        then 'kajabi_business_installment_legacy'
      when line_item_description is not null then 'kajabi_invoice_line'
      else 'unclassified'
    end as product_rule
  from ${ref("int_stripe_kajabi_payment_enrichment")} payment
),

named as (
  select
    classified.*,
    case product_rule
      when 'kajabi_mentorship_monthly' then 'subscription_plan_2149288216'
      when 'kajabi_business_installment_legacy' then 'subscription_plan_255477'
      else coalesce(plan_id, price_id)
    end as product_id,
    case product_rule
      when 'kajabi_mentorship_monthly' then 'Booming Bookkeeping Mentorship Program'
      when 'kajabi_business_installment_legacy' then 'Booming Bookkeeping Business (Installment Plan)'
      when 'kajabi_invoice_line' then regexp_replace(
        line_item_description,
        r'(?i)^\\s*\\d+\\s*[×x]\\s*|\\s*\\(at\\s+\\$[^)]*\\)\\s*$',
        ''
      )
      else 'unclassified'
    end as product_name,
    case
      when product_rule in ('kajabi_mentorship_monthly', 'kajabi_business_installment_legacy')
        then 'kajabi_plan_or_invoice_line'
      when product_rule = 'kajabi_invoice_line' then 'kajabi_invoice_line'
      else 'unclassified'
    end as product_classification_method,
    product_rule != 'unclassified' as is_product_classified
  from classified
),

sequenced as (
  select
    named.*,
    case
      when subscription_id is null then cast(null as int64)
      else row_number() over (
        partition by subscription_id
        order by payment_time, payment_id
      )
    end as payment_sequence_number
  from named
)

select
  sequenced.*,
  case
    when subscription_id is null then 'one_time'
    when invoice_billing_reason = 'subscription_create' then 'initial'
    else 'renewal'
  end as payment_occurrence_type,
  subscription_id is not null
    and coalesce(invoice_billing_reason != 'subscription_create', true)
    as is_repeat_payment
from sequenced
