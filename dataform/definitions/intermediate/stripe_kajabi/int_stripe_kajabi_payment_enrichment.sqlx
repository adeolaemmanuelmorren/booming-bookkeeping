config {
  type: "table",
  description: "Successful Kajabi Stripe charges enriched with customer, invoice, subscription, and invoice-line information.",
  tags: ["intermediate", "stripe_kajabi", "payments"],
  bigquery: {
    clusterBy: ["customer_id", "subscription_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with successful_charges as (
  select *
  from ${ref("stg_stripe_kajabi_charges")}
  where paid is true
    and status = 'succeeded'
),

line_summary as (
  select
    invoice_id,
    (
      array_agg(
        struct(
          line_item_id,
          subscription_id,
          price_id,
          plan_id,
          line_item_description,
          amount,
          quantity
        )
        order by amount_cents desc, line_item_id
        limit 1
      )
    )[safe_offset(0)] as best_line,
    string_agg(line_item_description, ', ' order by period_start, line_item_id) as complete_line_description
  from ${ref("stg_stripe_kajabi_invoice_line_items")}
  group by invoice_id
)

select
  charge.charge_id as payment_id,
  charge.charge_created_at as payment_time,
  date(charge.charge_created_at, 'America/Los_Angeles') as payment_date,
  charge.customer_id,
  coalesce(
    nullif(lower(trim(charge.billing_detail_email)), ''),
    nullif(lower(trim(charge.receipt_email)), ''),
    customer.email,
    payment_intent.receipt_email
  ) as payment_email,
  coalesce(nullif(trim(charge.billing_detail_name), ''), customer.name) as payment_name,
  coalesce(nullif(trim(charge.billing_detail_phone), ''), customer.phone) as payment_phone,
  charge.currency,
  charge.amount_cents,
  charge.amount as amount_paid,
  charge.amount_refunded_cents,
  charge.amount_refunded as refund_amount,
  charge.net_amount,
  charge.amount_refunded_cents > 0 as has_refund,
  charge.payment_intent_id,
  charge.payment_method_id,
  charge.invoice_id,
  coalesce(invoice.subscription_id, line.best_line.subscription_id) as subscription_id,
  invoice.billing_reason as invoice_billing_reason,
  line.best_line.line_item_id,
  line.best_line.price_id,
  line.best_line.plan_id,
  line.best_line.line_item_description,
  line.complete_line_description,
  line.best_line.quantity,
  line.best_line.amount as line_amount,
  charge.description as charge_description,
  charge.metadata_products,
  charge.calculated_statement_descriptor,
  charge.statement_descriptor,
  payment_intent.description as payment_intent_description,
  invoice.description as invoice_description,
  charge.receipt_url,
  charge.livemode
from successful_charges charge
left join ${ref("stg_stripe_kajabi_customers")} customer
  on customer.customer_id = charge.customer_id
left join ${ref("stg_stripe_kajabi_payment_intents")} payment_intent
  on payment_intent.payment_intent_id = charge.payment_intent_id
left join ${ref("stg_stripe_kajabi_invoices")} invoice
  on invoice.invoice_id = charge.invoice_id
left join line_summary line
  on line.invoice_id = charge.invoice_id
