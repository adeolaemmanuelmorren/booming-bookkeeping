config {
  type: "table",
  description: "Identifiers observed across Segment, ActiveCampaign, original Stripe, and Kajabi Stripe.",
  tags: ["intermediate", "identity"],
}

select
  'segment_identify' as source_system,
  identify_id as source_record_id,
  identified_at as observed_at,
  anonymous_id,
  user_id,
  email,
  phone,
  cast(null as string) as first_name,
  cast(null as string) as last_name
from ${ref("stg_identifies")}

union all

select
  'segment_form' as source_system,
  form_submission_id,
  submitted_at,
  anonymous_id,
  user_id,
  email,
  phone,
  first_name,
  cast(null as string)
from ${ref("stg_form_submissions_client_side")}

union all

select
  'segment_order_completed' as source_system,
  event_row_id,
  completed_at,
  anonymous_id,
  user_id,
  email,
  phone,
  split(customer_name, ' ')[safe_offset(0)],
  array_reverse(split(customer_name, ' '))[safe_offset(0)]
from ${ref("stg_order_completed")}

union all

select
  'segment_page_view' as source_system,
  page_view_id,
  page_view_timestamp,
  anonymous_id,
  user_id,
  cast(null as string),
  cast(null as string),
  cast(null as string),
  cast(null as string)
from ${ref("stg_page_views")}

union all

select
  'segment_attribution' as source_system,
  attribution_event_id,
  attribution_event_time,
  anonymous_id,
  user_id,
  user_id,
  cast(null as string),
  cast(null as string),
  cast(null as string)
from ${ref("stg_segment_attribution_params")}

union all

select
  'activecampaign' as source_system,
  form_submission_id,
  submitted_at,
  cast(null as string),
  email,
  email,
  phone,
  first_name,
  last_name
from ${ref("int_activecampaign_form_submissions")}

union all

select
  'stripe' as source_system,
  payment_id,
  payment_time,
  cast(null as string),
  payment_email,
  payment_email,
  payment_phone,
  split(payment_name, ' ')[safe_offset(0)],
  array_reverse(split(payment_name, ' '))[safe_offset(0)]
from ${ref("int_stripe_payment_occurrence")}

union all

select
  'stripe_kajabi' as source_system,
  payment_id,
  payment_time,
  cast(null as string),
  payment_email,
  payment_email,
  payment_phone,
  split(payment_name, ' ')[safe_offset(0)],
  array_reverse(split(payment_name, ' '))[safe_offset(0)]
from ${ref("int_stripe_kajabi_payment_occurrence")}
