config {
  type: "table",
  description: "One deterministic profile lookup row per normalized identifier.",
  tags: ["intermediate", "identity"],
  assertions: {
    uniqueKey: ["identifier_type", "identifier_value"],
    nonNull: ["identifier_type", "identifier_value", "profile_id"],
  },
}

with identifier_candidates as (
  select
    "anonymous_id" as identifier_type,
    anonymous_id as identifier_value,
    profile_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(anonymous_ids) as anonymous_id

  union all

  select
    "user_id" as identifier_type,
    user_id as identifier_value,
    profile_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(user_ids) as user_id

  union all

  select
    "email" as identifier_type,
    email as identifier_value,
    profile_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(emails) as email

  union all

  select
    "phone" as identifier_type,
    phone as identifier_value,
    profile_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(phones) as phone
)

select
  identifier_type,
  identifier_value,
  min(profile_id) as profile_id
from identifier_candidates
where identifier_value is not null
group by identifier_type, identifier_value
