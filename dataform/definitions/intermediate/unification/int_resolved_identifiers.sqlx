config {
  type: "table",
  description: "Profile spine that propagates known emails across anonymous IDs and user IDs.",
  tags: ["intermediate", "identity"],
}

with cleaned as (
  select
    * except (anonymous_id, user_id, email, phone),
    nullif(trim(anonymous_id), '') as anonymous_id,
    nullif(lower(trim(user_id)), '') as user_id,
    nullif(lower(trim(email)), '') as email,
    nullif(regexp_replace(phone, r'[^0-9+]', ''), '') as phone
  from ${ref("int_identity_events")}
),

email_by_anonymous_id as (
  select
    anonymous_id,
    array_agg(email ignore nulls order by observed_at desc limit 1)[safe_offset(0)] as email
  from cleaned
  where anonymous_id is not null
    and email is not null
  group by anonymous_id
),

email_by_user_id as (
  select
    user_id,
    array_agg(email ignore nulls order by observed_at desc limit 1)[safe_offset(0)] as email
  from cleaned
  where user_id is not null
    and email is not null
  group by user_id
),

normalized as (
  select
    cleaned.*,
    coalesce(
      cleaned.email,
      email_by_anonymous_id.email,
      email_by_user_id.email,
      cleaned.user_id,
      cleaned.anonymous_id,
      cleaned.phone
    ) as profile_key
  from cleaned
  left join email_by_anonymous_id using (anonymous_id)
  left join email_by_user_id using (user_id)
),

profile_rollup as (
  select
    to_hex(md5(profile_key)) as profile_id,
    profile_key,
    array_agg(distinct anonymous_id ignore nulls) as anonymous_ids,
    array_agg(distinct user_id ignore nulls) as user_ids,
    array_agg(distinct email ignore nulls) as emails,
    array_agg(distinct phone ignore nulls) as phones,
    array_agg(first_name ignore nulls order by observed_at desc limit 1)[safe_offset(0)] as first_name,
    array_agg(last_name ignore nulls order by observed_at desc limit 1)[safe_offset(0)] as last_name,
    min(observed_at) as first_seen_at,
    max(observed_at) as last_seen_at
  from normalized
  where profile_key is not null
  group by profile_key
)

select * from profile_rollup
