config {
  type: "table",
  description: "Latest active manual Stripe payment-to-profile link per payment.",
  tags: ["intermediate", "manual_attribution"],
}

with ranked as (
  select
    nullif(trim(payment_id), '') as payment_id,
    nullif(trim(profile_id), '') as manual_profile_id,
    lower(nullif(trim(action), '')) as action,
    created_at as manual_link_created_at,
    nullif(trim(created_by), '') as manual_link_created_by,
    row_number() over (
      partition by nullif(trim(payment_id), '')
      order by created_at desc, link_event_id desc
    ) as event_rank
  from ${ref("manual_payment_profile_link_events")}
  where nullif(trim(payment_id), '') is not null
)

select
  payment_id,
  manual_profile_id,
  manual_link_created_at,
  manual_link_created_by
from ranked
where event_rank = 1
  and action = 'link'
  and manual_profile_id is not null
