config {
  type: "table",
  description: "Configured ActiveCampaign registration-tag assignments modeled as server-side form submissions.",
  tags: ["intermediate", "activecampaign", "forms"],
}

js {
  const {
    activeCampaignRegistrationForms,
  } = require("includes/business_rules");

  function quote(value) {
    return "'" + String(value).split("'").join("''") + "'";
  }

  function exactTagCondition(tags) {
    if (!tags.length) {
      return "false";
    }

    return "tag.tag_name in (" + tags.map(quote).join(", ") + ")";
  }

  function prefixTagCondition(prefixes) {
    if (!prefixes.length) {
      return "false";
    }

    return prefixes
      .map((prefix) => "starts_with(tag.tag_name, " + quote(prefix) + ")")
      .join("\n        or ");
  }

  function primaryTagCondition(registrationForm) {
    return [
      exactTagCondition(registrationForm.primaryExactTags),
      prefixTagCondition(registrationForm.primaryTagPrefixes),
    ].join("\n        or ");
  }

  function fallbackTagCondition(registrationForm) {
    if (!registrationForm.fallbackExactTag) {
      return "false";
    }

    return "tag.tag_name = " + quote(registrationForm.fallbackExactTag);
  }

  const registrationTypeCase = activeCampaignRegistrationForms
    .map((registrationForm) => `
      when (
        ${primaryTagCondition(registrationForm)}
        or ${fallbackTagCondition(registrationForm)}
      ) then ${quote(registrationForm.registrationType)}`)
    .join("");

  const tagMatchTypeCase = activeCampaignRegistrationForms
    .flatMap((registrationForm) => [
      `
      when (
        ${primaryTagCondition(registrationForm)}
      ) then 'primary'`,
      `
      when (
        ${fallbackTagCondition(registrationForm)}
      ) then 'fallback'`,
    ])
    .join("");

  const configuredTagCondition = activeCampaignRegistrationForms
    .map((registrationForm) => `
      (
        ${primaryTagCondition(registrationForm)}
        or ${fallbackTagCondition(registrationForm)}
      )`)
    .join("\n      or ");

  const contentNameCase = activeCampaignRegistrationForms
    .map((registrationForm) => `
      when ${quote(registrationForm.registrationType)}
        then ${quote(registrationForm.contentName)}`)
    .join("");
}

with classified_assignments as (
  select
    contact_tag.contact_tag_id as form_submission_id,
    contact_tag.assigned_at as submitted_at,
    contact.contact_id,
    contact.email,
    contact.phone,
    contact.first_name,
    contact.last_name,
    contact.full_name,
    tag.tag_id,
    tag.tag_name,
    case
      ${registrationTypeCase}
    end as registration_type,
    case
      ${tagMatchTypeCase}
    end as tag_match_type
  from ${ref("stg_activecampaign_contact_tags")} contact_tag
  join ${ref("stg_activecampaign_tags")} tag
    on tag.tag_id = contact_tag.tag_id
  join ${ref("stg_activecampaign_contacts")} contact
    on contact.contact_id = contact_tag.contact_id
  where contact_tag.is_deleted is false
    and tag.is_deleted is false
    and contact.is_deleted is false
    and (
      ${configuredTagCondition}
    )
),

contacts_with_primary_registration as (
  select distinct
    contact_id,
    registration_type
  from classified_assignments
  where tag_match_type = 'primary'
),

eligible_assignments as (
  select assignments.*
  from classified_assignments assignments
  left join contacts_with_primary_registration primary_registration
    using (contact_id, registration_type)
  where assignments.tag_match_type = 'primary'
     or (
       assignments.tag_match_type = 'fallback'
       and primary_registration.contact_id is null
     )
)

select
  eligible_assignments.* except (tag_match_type),
  case registration_type
    ${contentNameCase}
  end as content_name,
  case
    when email is not null then concat(
      'form_submission_',
      lower(to_hex(sha256(concat(
        lower(trim(email)),
        '|',
        registration_type,
        '|',
        format_date('%F', date(submitted_at, 'America/Los_Angeles'))
      ))))
    )
  end as canonical_event_id,
  'activecampaign_tag' as form_type,
  'activecampaign' as event_source,
  tag_match_type as registration_tag_type
from eligible_assignments
