config {
  type: "assertion",
  description: "Fails when repeat-payment fields contradict the agreed occurrence rules.",
  tags: ["assertion", "stripe", "payments"],
}

select *
from ${ref("mart_payments")}
where (payment_occurrence_type in ('one_time', 'initial') and is_repeat_payment)
  or (payment_occurrence_type in ('renewal', 'installment', 'balance') and not is_repeat_payment)
  or (subscription_id is null and payment_sequence_number is not null)
  or (subscription_id is not null and payment_sequence_number is null)

