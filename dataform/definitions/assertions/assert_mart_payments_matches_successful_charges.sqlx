config {
  type: "assertion",
  description: "Fails when mart_payments differs from the combined raw successful-charge grain or financial totals.",
  tags: ["assertion", "stripe", "payments"],
}

with raw as (
  select
    count(*) as payment_count,
    sum(cast(amount as numeric) / 100) as amount_paid,
    sum(cast(amount_refunded as numeric) / 100) as refund_amount,
    sum(cast(amount - amount_refunded as numeric) / 100) as net_amount
  from (
    select amount, amount_refunded
    from `able-folio-499722.stripe.charge`
    where paid is true and status = 'succeeded'

    union all

    select amount, amount_refunded
    from `able-folio-499722.stripe_kajabi.charge`
    where paid is true and status = 'succeeded'
  )
),

mart as (
  select
    count(*) as payment_count,
    sum(amount_paid) as amount_paid,
    sum(refund_amount) as refund_amount,
    sum(net_amount) as net_amount
  from ${ref("mart_payments")}
)

select
  raw.payment_count as raw_payment_count,
  mart.payment_count as mart_payment_count,
  raw.amount_paid as raw_amount_paid,
  mart.amount_paid as mart_amount_paid,
  raw.refund_amount as raw_refund_amount,
  mart.refund_amount as mart_refund_amount,
  raw.net_amount as raw_net_amount,
  mart.net_amount as mart_net_amount
from raw
cross join mart
where raw.payment_count != mart.payment_count
  or raw.amount_paid != mart.amount_paid
  or raw.refund_amount != mart.refund_amount
  or raw.net_amount != mart.net_amount
