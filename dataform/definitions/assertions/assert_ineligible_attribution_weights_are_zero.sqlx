config {
  type: "assertion",
  description: "Direct and non-paid touches must not receive ineligible attribution weight.",
  tags: ["assertion", "attribution"],
}

select *
from ${ref("mart_conversions_with_touchpoints")}
where (
    is_direct_touch
    and (
      multi_touch_weight != 0
      or first_touch_weight != 0
      or last_touch_weight != 0
    )
  )
  or (
    not is_paid_ad_touch
    and (
      paid_multi_touch_weight != 0
      or paid_first_touch_weight != 0
      or paid_last_touch_weight != 0
    )
  )
