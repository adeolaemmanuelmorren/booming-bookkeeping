config {
  type: "view",
  description: "Client-side Segment Order Completed events emitted by the shared checkout tracking bundle.",
  tags: ["staging", "segment", "payments"],
}

with raw_events as (
  select
    * except (
      extra_submitted_fields_checkout_offer_service_agreement,
      products
    ),
    products,
    'boom_domains' as source_system,
    1 as source_priority
  from `able-folio-499722.boom_domains.order_completed`

  full outer union all by name

  select
    * except (
      extra_submitted_fields_checkout_offer_service_agreement,
      products
    ),
    to_json_string(products) as products,
    'jitsu_data' as source_system,
    2 as source_priority
  from `able-folio-499722.jitsu_data.Order Completed`
)

select
  coalesce(message_id, id) as event_row_id,
  source_system,
  event_id,
  coalesce(timestamp, submitted_at, sent_at, received_at, loaded_at) as completed_at,
  nullif(trim(anonymous_id), '') as anonymous_id,
  nullif(lower(trim(user_id)), '') as user_id,
  coalesce(
    nullif(lower(trim(email)), ''),
    nullif(lower(trim(context_traits_email)), ''),
    nullif(lower(trim(user_id)), '')
  ) as email,
  coalesce(nullif(trim(phone), ''), nullif(trim(context_traits_phone), '')) as phone,
  nullif(trim(name), '') as customer_name,
  nullif(trim(order_id), '') as order_id,
  nullif(trim(checkout_id), '') as checkout_id,
  nullif(trim(checkout_submission_id), '') as checkout_submission_id,
  nullif(trim(product_id), '') as product_id,
  nullif(trim(product_name), '') as product_name,
  nullif(trim(products), '') as products,
  cast(value as numeric) as value,
  upper(nullif(trim(currency), '')) as currency,
  nullif(trim(completion_basis), '') as completion_basis,
  is_payment_confirmed,
  nullif(trim(payment_status), '') as payment_status,
  nullif(trim(extra_submitted_fields_checkout_offer_payment_method_id), '') as stripe_payment_method_id,
  nullif(trim(extra_submitted_fields_checkout_offer_payment_method_type), '') as payment_method_type,
  nullif(trim(extra_submitted_fields_checkout_offer_payment_provider), '') as payment_provider,
  nullif(trim(form_id), '') as form_id,
  nullif(trim(form_action), '') as form_action,
  nullif(trim(coalesce(page_url, context_page_url)), '') as page_url,
  nullif(trim(coalesce(page_path, context_page_path)), '') as page_path,
  nullif(trim(context_page_referrer), '') as page_referrer,
  nullif(trim(context_ip), '') as ip_address,
  nullif(trim(context_user_agent), '') as user_agent,
  coalesce(
    nullif(trim(context_edge_city), ''),
    nullif(trim(context_geo_city_name), '')
  ) as geo_city,
  coalesce(
    nullif(trim(context_edge_region), ''),
    nullif(trim(context_geo_region_name), '')
  ) as geo_region,
  coalesce(
    nullif(trim(context_edge_country), ''),
    nullif(trim(context_geo_country_code), '')
  ) as geo_country,
  nullif(trim(context_attribution_fbp), '') as fbp,
  nullif(trim(context_attribution_ttp), '') as ttp,
  nullif(trim(context_attribution_uetsid), '') as uetsid,
  nullif(trim(context_attribution_uetvid), '') as uetvid
from raw_events
qualify row_number() over (
  partition by coalesce(message_id, id)
  order by
    source_priority desc,
    coalesce(loaded_at, received_at, sent_at, timestamp) desc
) = 1
