config {
  type: "view",
  description: "Segment page views with Boom-specific paid URL templates, click IDs, and normalized traffic dimensions.",
  tags: ["staging", "segment", "page_views"],
}

js {
  const { normalizedSource, urlHost, urlParameter } = require("includes/url");
}

with raw_events as (
  select
    *,
    'boom_domains' as source_system,
    1 as source_priority,
    _partitiontime as source_partition_time
  from `able-folio-499722.boom_domains.pages`

  full outer union all by name

  select
    *,
    'jitsu_data' as source_system,
    2 as source_priority,
    timestamp_trunc(timestamp, day) as source_partition_time
  from `able-folio-499722.jitsu_data.pages`
),

source as (
  select
    coalesce(message_id, id) as page_view_id,
    source_system,
    nullif(trim(anonymous_id), '') as anonymous_id,
    nullif(lower(trim(user_id)), '') as user_id,
    coalesce(timestamp, sent_at, received_at, loaded_at) as page_view_timestamp,
    nullif(trim(coalesce(url, context_page_url)), '') as page_url,
    nullif(trim(coalesce(path, context_page_path)), '') as page_path,
    nullif(trim(coalesce(title, context_page_title)), '') as page_title,
    nullif(trim(coalesce(referrer, context_page_referrer)), '') as page_referrer,
    nullif(trim(context_ip), '') as ip_address,
    nullif(trim(context_user_agent), '') as user_agent,
    nullif(trim(context_user_agent_data_platform), '') as device_platform,
    context_user_agent_data_mobile as device_is_mobile,
    coalesce(
      nullif(trim(context_edge_city), ''),
      nullif(trim(context_geo_city_name), '')
    ) as geo_city,
    coalesce(
      nullif(trim(context_edge_region), ''),
      nullif(trim(context_geo_region_name), '')
    ) as geo_region,
    coalesce(
      nullif(trim(context_edge_region_code), ''),
      nullif(trim(context_geo_region_code), '')
    ) as geo_region_code,
    coalesce(
      nullif(trim(context_edge_country), ''),
      nullif(trim(context_geo_country_code), '')
    ) as geo_country,
    coalesce(
      nullif(trim(context_edge_timezone), ''),
      nullif(trim(context_geo_location_timezone), '')
    ) as geo_timezone,
    coalesce(
      nullif(trim(context_attribution_utm_source), ''),
      nullif(trim(context_campaign_utm_source), ''),
      nullif(trim(context_campaign_source), ''),
      ${urlParameter("url", "utm_source")}
    ) as raw_utm_source,
    coalesce(
      nullif(trim(context_attribution_utm_medium), ''),
      nullif(trim(context_campaign_utm_medium), ''),
      nullif(trim(context_campaign_medium), ''),
      ${urlParameter("url", "utm_medium")}
    ) as raw_utm_medium,
    coalesce(
      nullif(trim(context_attribution_utm_campaign), ''),
      nullif(trim(context_campaign_utm_campaign), ''),
      nullif(trim(context_campaign_name), ''),
      ${urlParameter("url", "utm_campaign")}
    ) as utm_campaign,
    coalesce(
      nullif(trim(context_attribution_utm_content), ''),
      nullif(trim(context_campaign_utm_content), ''),
      nullif(trim(context_campaign_content), ''),
      ${urlParameter("url", "utm_content")}
    ) as utm_content,
    coalesce(
      nullif(trim(context_attribution_utm_term), ''),
      nullif(trim(context_campaign_utm_term), ''),
      nullif(trim(context_campaign_term), ''),
      ${urlParameter("url", "utm_term")}
    ) as utm_term,
    coalesce(
      nullif(trim(context_attribution_utm_id), ''),
      nullif(trim(context_campaign_utm_id), ''),
      nullif(trim(context_campaign_id), ''),
      ${urlParameter("url", "utm_id")}
    ) as utm_id,
    coalesce(nullif(trim(context_attribution_gclid), ''), ${urlParameter("url", "gclid")}) as gclid,
    coalesce(nullif(trim(context_attribution_gbraid), ''), ${urlParameter("url", "gbraid")}) as gbraid,
    coalesce(nullif(trim(context_attribution_wbraid), ''), ${urlParameter("url", "wbraid")}) as wbraid,
    coalesce(nullif(trim(context_attribution_fbclid), ''), ${urlParameter("url", "fbclid")}) as fbclid,
    coalesce(nullif(trim(context_attribution_ttclid), ''), ${urlParameter("url", "ttclid")}) as ttclid,
    coalesce(nullif(trim(context_attribution_li_fat_id), ''), ${urlParameter("url", "li_fat_id")}) as li_fat_id,
    coalesce(nullif(trim(context_attribution_rdt_cid), ''), ${urlParameter("url", "rdt_cid")}) as rdt_cid,
    coalesce(nullif(trim(context_attribution_twclid), ''), ${urlParameter("url", "twclid")}) as twclid,
    nullif(trim(context_attribution_fbc), '') as fbc,
    nullif(trim(context_attribution_fbp), '') as fbp,
    nullif(trim(context_attribution_ttp), '') as ttp,
    nullif(trim(context_attribution_uetsid), '') as uetsid,
    nullif(trim(context_attribution_uetvid), '') as uetvid,
    ${urlParameter("url", "gc_id")} as google_campaign_id,
    ${urlParameter("url", "h_ga_id")} as google_ad_group_id,
    ${urlParameter("url", "h_ad_id")} as google_ad_id,
    ${urlParameter("url", "h_keyword_id")} as google_keyword_id,
    ${urlParameter("url", "h_keyword")} as google_keyword,
    source_partition_time
  from raw_events
  qualify row_number() over (
    partition by coalesce(message_id, id)
    order by
      source_priority desc,
      coalesce(loaded_at, received_at, sent_at, timestamp) desc
  ) = 1
),

normalized as (
  select
    *,
    ${urlHost("page_url")} as page_host,
    ${urlHost("page_referrer")} as page_referrer_host,
    case
      when fbclid is not null
        or (
          lower(raw_utm_source) in ('fb', 'ig', 'facebook', 'instagram', 'meta', 'an', 'th', 'msg')
          and utm_campaign is not null
        )
        then 'meta'
      when gclid is not null or gbraid is not null or wbraid is not null then 'google'
      when ttclid is not null then 'tiktok'
      else ${normalizedSource("raw_utm_source")}
    end as utm_source
  from source
)

select
  * except (raw_utm_source, raw_utm_medium),
  nullif(lower(trim(raw_utm_medium)), '') as utm_medium,
  concat(coalesce(page_path, ''), coalesce(page_host, '')) as page_path_host,
  case
    when utm_source = 'meta' then coalesce(utm_campaign, utm_id)
    when utm_source = 'google' then google_campaign_id
  end as campaign_id,
  case when utm_source = 'meta' then utm_term
       when utm_source = 'google' then google_ad_group_id end as adset_id,
  case when utm_source = 'meta' then utm_content
       when utm_source = 'google' then google_ad_id end as ad_id,
  case
    when gclid is not null then gclid
    when gbraid is not null then gbraid
    when wbraid is not null then wbraid
    when fbclid is not null then fbclid
    when ttclid is not null then ttclid
    when li_fat_id is not null then li_fat_id
    when rdt_cid is not null then rdt_cid
    when twclid is not null then twclid
  end as click_id,
  case
    when gclid is not null then 'gclid'
    when gbraid is not null then 'gbraid'
    when wbraid is not null then 'wbraid'
    when fbclid is not null then 'fbclid'
    when ttclid is not null then 'ttclid'
    when li_fat_id is not null then 'li_fat_id'
    when rdt_cid is not null then 'rdt_cid'
    when twclid is not null then 'twclid'
  end as click_id_type,
  coalesce(
    utm_source,
    case
      when page_referrer_host is null then 'direct'
      when regexp_contains(page_referrer_host, r'(^|\\.)boomingbookkeeping\\.com$') then 'direct'
      else page_referrer_host
    end
  ) as channel_source,
  case
    when lower(raw_utm_medium) in ('paid', 'paid_social', 'cpc', 'ppc') then 'cpc'
    when utm_source in ('meta', 'google', 'tiktok') then 'cpc'
    when raw_utm_medium is not null then lower(raw_utm_medium)
    when page_referrer_host is null then 'none'
    else 'referral'
  end as channel_medium
from normalized
