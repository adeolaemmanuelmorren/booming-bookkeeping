config {
  type: "view",
  description: "Dedicated Segment attribution events with normalized campaign and paid-click parameters.",
  tags: ["staging", "segment", "attribution"],
}

js {
  const { normalizedSource } = require("includes/url");
}

with raw_events as (
  select
    *,
    'boom_domains' as source_system,
    1 as source_priority,
    _partitiontime as source_partition_time
  from `able-folio-499722.boom_domains.attr`

  full outer union all by name

  select
    *,
    'jitsu_data' as source_system,
    2 as source_priority,
    timestamp_trunc(timestamp, day) as source_partition_time
  from `able-folio-499722.jitsu_data.attr`
),

source as (
  select
    coalesce(message_id, id) as attribution_event_id,
    source_system,
    nullif(trim(event), '') as event_name,
    coalesce(timestamp, sent_at, received_at, loaded_at, original_timestamp, uuid_ts)
      as attribution_event_time,
    nullif(trim(anonymous_id), '') as anonymous_id,
    nullif(lower(trim(user_id)), '') as user_id,
    nullif(trim(context_page_url), '') as page_url,
    nullif(trim(context_page_path), '') as page_path,
    nullif(trim(context_ip), '') as ip_address,
    nullif(trim(context_user_agent), '') as user_agent,
    coalesce(
      nullif(trim(utm_source), ''),
      nullif(trim(context_attribution_utm_source), ''),
      nullif(trim(context_campaign_source), '')
    ) as raw_utm_source,
    coalesce(
      nullif(trim(utm_medium), ''),
      nullif(trim(context_attribution_utm_medium), ''),
      nullif(trim(context_campaign_medium), '')
    ) as utm_medium,
    coalesce(
      nullif(trim(utm_campaign), ''),
      nullif(trim(context_attribution_utm_campaign), ''),
      nullif(trim(context_campaign_name), '')
    ) as utm_campaign,
    coalesce(
      nullif(trim(utm_content), ''),
      nullif(trim(context_attribution_utm_content), ''),
      nullif(trim(context_campaign_content), '')
    ) as utm_content,
    coalesce(
      nullif(trim(utm_term), ''),
      nullif(trim(context_attribution_utm_term), ''),
      nullif(trim(context_campaign_term), '')
    ) as utm_term,
    coalesce(
      nullif(trim(utm_id), ''),
      nullif(trim(context_attribution_utm_id), ''),
      nullif(trim(context_campaign_id), '')
    ) as utm_id,
    coalesce(nullif(trim(gclid), ''), nullif(trim(context_attribution_gclid), '')) as gclid,
    coalesce(nullif(trim(gbraid), ''), nullif(trim(context_attribution_gbraid), '')) as gbraid,
    coalesce(nullif(trim(wbraid), ''), nullif(trim(context_attribution_wbraid), '')) as wbraid,
    coalesce(nullif(trim(fbclid), ''), nullif(trim(context_attribution_fbclid), '')) as fbclid,
    coalesce(nullif(trim(ttclid), ''), nullif(trim(context_attribution_ttclid), '')) as ttclid,
    coalesce(nullif(trim(li_fat_id), ''), nullif(trim(context_attribution_li_fat_id), '')) as li_fat_id,
    coalesce(nullif(trim(rdt_cid), ''), nullif(trim(context_attribution_rdt_cid), '')) as rdt_cid,
    coalesce(nullif(trim(twclid), ''), nullif(trim(context_attribution_twclid), '')) as twclid,
    coalesce(nullif(trim(fbc), ''), nullif(trim(context_attribution_fbc), '')) as fbc,
    coalesce(nullif(trim(fbp), ''), nullif(trim(context_attribution_fbp), '')) as fbp,
    coalesce(nullif(trim(ttp), ''), nullif(trim(context_attribution_ttp), '')) as ttp,
    coalesce(nullif(trim(uetsid), ''), nullif(trim(context_attribution_uetsid), '')) as uetsid,
    coalesce(nullif(trim(uetvid), ''), nullif(trim(context_attribution_uetvid), '')) as uetvid,
    source_partition_time
  from raw_events
  qualify row_number() over (
    partition by coalesce(message_id, id)
    order by
      source_priority desc,
      coalesce(loaded_at, received_at, sent_at, timestamp) desc
  ) = 1
)

select
  * except (raw_utm_source),
  case
    when fbclid is not null then 'meta'
    when gclid is not null or gbraid is not null or wbraid is not null then 'google'
    when ttclid is not null then 'tiktok'
    else ${normalizedSource("raw_utm_source")}
  end as utm_source
from source
