config {
  type: "view",
  description: "All client-side Segment form submissions with structural checkout classification and safe reconciliation identifiers.",
  tags: ["staging", "segment", "forms"],
}

js {
  const {
    activeCampaignRegistrationForms,
  } = require("includes/business_rules");

  function quote(value) {
    return "'" + String(value).split("'").join("''") + "'";
  }

  const registrationTypes = activeCampaignRegistrationForms
    .map((registrationForm) => quote(registrationForm.registrationType))
    .join(", ");

  const registrationTypeCase = activeCampaignRegistrationForms
    .map((registrationForm) => `
      when active_campaign_form_id in (
        ${registrationForm.activeCampaignFormIds.map(quote).join(", ")}
      ) then ${quote(registrationForm.registrationType)}`)
    .join("");

  const contentNameCase = activeCampaignRegistrationForms
    .map((registrationForm) => `
      when ${quote(registrationForm.registrationType)}
        then ${quote(registrationForm.contentName)}`)
    .join("");
}

with raw_events as (
  select
    *,
    'boom_domains' as source_system,
    1 as source_priority
  from `able-folio-499722.boom_domains.form_submitted`

  full outer union all by name

  select
    *,
    'jitsu_data' as source_system,
    2 as source_priority
  from `able-folio-499722.jitsu_data.Form Submitted`
),

source as (
  select
    coalesce(message_id, id) as form_submission_id,
    source_system,
    event_id,
    coalesce(submitted_at, timestamp, sent_at, received_at, loaded_at) as submitted_at,
    nullif(trim(anonymous_id), '') as anonymous_id,
    nullif(lower(trim(user_id)), '') as user_id,
    coalesce(
      nullif(lower(trim(email)), ''),
      nullif(lower(trim(extra_submitted_fields_checkout_offer_member_email)), ''),
      nullif(lower(trim(context_traits_email)), ''),
      nullif(lower(trim(user_id)), '')
    ) as email,
    coalesce(nullif(trim(phone), ''), nullif(trim(context_traits_phone), '')) as phone,
    nullif(trim(first_name), '') as first_name,
    nullif(trim(extra_submitted_fields_checkout_offer_member_name), '') as checkout_member_name,
    nullif(trim(form_id), '') as form_id,
    nullif(trim(form_name), '') as form_name,
    nullif(trim(form_action), '') as form_action,
    nullif(trim(form_method), '') as form_method,
    nullif(trim(coalesce(page_url, context_page_url)), '') as page_url,
    nullif(trim(coalesce(page_path, context_page_path)), '') as page_path,
    nullif(trim(context_page_referrer), '') as page_referrer,
    nullif(trim(context_ip), '') as ip_address,
    nullif(trim(context_user_agent), '') as user_agent,
    coalesce(
      nullif(trim(context_edge_city), ''),
      nullif(trim(context_geo_city_name), '')
    ) as geo_city,
    coalesce(
      nullif(trim(context_edge_region), ''),
      nullif(trim(context_geo_region_name), '')
    ) as geo_region,
    coalesce(
      nullif(trim(context_edge_country), ''),
      nullif(trim(context_geo_country_code), '')
    ) as geo_country,
    nullif(trim(extra_submitted_fields_checkout_offer_payment_method_id), '') as stripe_payment_method_id,
    nullif(trim(extra_submitted_fields_checkout_offer_payment_method_type), '') as payment_method_type,
    nullif(trim(extra_submitted_fields_checkout_offer_payment_provider), '') as payment_provider,
    nullif(trim(extra_submitted_fields_payment_type), '') as payment_type,
    nullif(trim(extra_submitted_fields_coupon), '') as coupon,
    nullif(trim(context_attribution_gclid), '') as gclid,
    nullif(trim(context_attribution_gbraid), '') as gbraid,
    nullif(trim(context_attribution_fbclid), '') as fbclid,
    nullif(trim(context_attribution_fbc), '') as fbc,
    nullif(trim(context_attribution_fbp), '') as fbp,
    nullif(trim(context_attribution_ttp), '') as ttp,
    nullif(trim(context_attribution_uetsid), '') as uetsid,
    nullif(trim(context_attribution_uetvid), '') as uetvid,
    nullif(trim(context_attribution_utm_source), '') as utm_source,
    nullif(trim(context_attribution_utm_medium), '') as utm_medium,
    nullif(trim(context_attribution_utm_campaign), '') as utm_campaign,
    nullif(trim(context_attribution_utm_content), '') as utm_content,
    nullif(trim(context_attribution_utm_term), '') as utm_term,
    nullif(
      trim(json_value(to_json_string(raw), '$.active_campaign_form_id')),
      ''
    ) as payload_active_campaign_form_id,
    nullif(
      lower(trim(json_value(to_json_string(raw), '$.registration_type'))),
      ''
    ) as payload_registration_type
  from raw_events raw
  qualify row_number() over (
    partition by coalesce(message_id, id)
    order by
      source_priority desc,
      coalesce(loaded_at, received_at, sent_at, timestamp) desc
  ) = 1
),

classified as (
  select
    source.* except (payload_active_campaign_form_id),
    coalesce(
      payload_active_campaign_form_id,
      regexp_extract(form_id, r'(?i)^_form_(\d+)_$')
    ) as active_campaign_form_id
  from source
),

registration_labeled as (
  select
    classified.* except (payload_registration_type),
    case
      when payload_registration_type in (${registrationTypes})
        then payload_registration_type
      ${registrationTypeCase}
    end as registration_type
  from classified
)

select
  *,
  case registration_type
    ${contentNameCase}
  end as content_name,
  case
    when email is not null
      and registration_type is not null
      and submitted_at is not null
      then concat(
        'form_submission_',
        lower(to_hex(sha256(concat(
          lower(trim(email)),
          '|',
          registration_type,
          '|',
          format_date('%F', date(submitted_at, 'America/Los_Angeles'))
        ))))
      )
  end as canonical_event_id,
  (
    lower(coalesce(form_id, '')) = 'new_checkout_offer'
    or lower(coalesce(form_name, '')) = 'new_checkout_offer'
    or regexp_contains(lower(coalesce(form_action, '')), r'/offers/[^/]+/checkout')
    or regexp_contains(lower(coalesce(page_path, '')), r'/offers/[^/]+/checkout')
    or payment_method_type is not null
  ) as is_checkout_form,
  case
    when lower(coalesce(form_id, '')) = 'new_checkout_offer'
      or regexp_contains(lower(coalesce(form_action, '')), r'/offers/[^/]+/checkout')
      or regexp_contains(lower(coalesce(page_path, '')), r'/offers/[^/]+/checkout')
      or payment_method_type is not null
      then 'checkout'
    else 'lead'
  end as form_type,
  regexp_extract(coalesce(form_action, page_path), r'(?i)/offers/([^/]+)/checkout') as offer_id
from registration_labeled
