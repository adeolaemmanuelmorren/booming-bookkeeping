config {
  type: "operations",
  schema: "manual_attribution",
  hasOutput: true,
  description: "Append-only manual Stripe payment-to-profile link events written by the attribution interface.",
  tags: ["source", "manual_attribution"],
}

create schema if not exists `able-folio-499722.manual_attribution`
options(location = 'US');

create table if not exists ${self()} (
  link_event_id string not null,
  payment_id string not null,
  profile_id string,
  action string not null,
  created_at timestamp not null,
  created_by string
);
