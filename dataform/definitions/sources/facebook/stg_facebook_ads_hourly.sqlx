config {
  type: "table",
  description: "Hourly Meta Ads performance. The advertiser-time-zone breakdown is required before downstream reporting.",
  tags: ["staging", "facebook_ads", "meta_ads", "ads", "hourly"],
  assertions: {
    uniqueKey: ["hour_start", "account_id", "ad_id"],
    nonNull: [
      "hour_start",
      "hour_bucket",
      "hour_breakdown_type",
      "account_id",
      "campaign_id",
      "campaign_name",
      "adset_id",
      "adset_name",
      "ad_id",
      "ad_name",
      "spend",
    ],
    rowConditions: [
      "impressions >= 0",
      "clicks >= 0",
      "spend >= 0",
    ],
  },
  bigquery: {
    clusterBy: ["campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const { reportingTimeZone } = require("includes/reporting_time");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with latest_campaign as (
  select
    cast(id as string) as campaign_id,
    nullif(trim(name), '') as campaign_name
  from ${resolve("facebook_ads", "campaign_history")}
  qualify row_number() over (
    partition by id
    order by updated_time desc, _fivetran_synced desc
  ) = 1
),

latest_adset as (
  select
    cast(id as string) as adset_id,
    nullif(trim(name), '') as adset_name
  from ${resolve("facebook_ads", "ad_set_history")}
  qualify row_number() over (
    partition by id
    order by updated_time desc, _fivetran_synced desc
  ) = 1
),

latest_creative as (
  select
    cast(id as string) as creative_id,
    coalesce(
      nullif(trim(link_url), ''),
      nullif(trim(object_url), ''),
      nullif(trim(object_story_link_data_link), ''),
      nullif(trim(template_link), ''),
      nullif(trim(video_call_to_action_value_link), ''),
      nullif(trim(template_url_spec_web_url), ''),
      nullif(trim(page_link), ''),
      nullif(trim(template_page_link), '')
    ) as landing_page_url
  from ${resolve("facebook_ads", "creative_history")}
  qualify row_number() over (
    partition by id
    order by _fivetran_synced desc, _fivetran_id desc
  ) = 1
),

latest_ad as (
  select
    cast(id as string) as ad_id,
    cast(campaign_id as string) as campaign_id,
    cast(ad_set_id as string) as adset_id,
    cast(creative_id as string) as creative_id,
    nullif(trim(name), '') as ad_name
  from ${resolve("facebook_ads", "ad_history")}
  qualify row_number() over (
    partition by id
    order by updated_time desc, _fivetran_synced desc
  ) = 1
),

performance as (
  select
    timestamp(
      datetime(
        date,
        parse_time(
          '%H:%M:%S',
          split(
            hourly_stats_aggregated_by_advertiser_time_zone,
            ' - '
          )[safe_offset(0)]
        )
      ),
      "${reportingTimeZone}"
    ) as hour_start,
    date,
    hourly_stats_aggregated_by_advertiser_time_zone as hour_bucket,
    'advertiser' as hour_breakdown_type,
    cast(account_id as string) as account_id,
    cast(ad_id as string) as ad_id,
    cast(adset_id as string) as adset_id,
    nullif(trim(ad_name), '') as ad_name,
    nullif(trim(adset_name), '') as adset_name,
    cast(campaign_id as string) as campaign_id,
    nullif(trim(campaign_name), '') as campaign_name,
    cast(impressions as int64) as impressions,
    cast(inline_link_clicks as int64) as inline_link_clicks,
    cast(spend as numeric) as spend
  from ${resolve("facebook_ads", "basic_ad_hourly")}
  where date <= current_date("${reportingTimeZone}")
    and hourly_stats_aggregated_by_advertiser_time_zone is not null
)

select
  performance.hour_start,
  performance.date,
  performance.hour_bucket,
  performance.hour_breakdown_type,
  performance.account_id,
  cast(null as string) as account_name,
  coalesce(latest_ad.campaign_id, performance.campaign_id) as campaign_id,
  coalesce(latest_campaign.campaign_name, performance.campaign_name) as campaign_name,
  coalesce(latest_ad.adset_id, performance.adset_id) as adset_id,
  coalesce(latest_adset.adset_name, performance.adset_name) as adset_name,
  performance.ad_id,
  coalesce(latest_ad.ad_name, performance.ad_name) as ad_name,
  latest_creative.landing_page_url,
  performance.impressions,
  performance.inline_link_clicks as clicks,
  performance.spend,
  'USD' as currency
from performance
left join latest_ad
  using (ad_id)
left join latest_creative
  using (creative_id)
left join latest_adset
  on latest_adset.adset_id = latest_ad.adset_id
left join latest_campaign
  on latest_campaign.campaign_id = coalesce(latest_ad.campaign_id, performance.campaign_id)
