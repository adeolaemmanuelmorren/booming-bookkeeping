config {
  type: "view",
  description: "Kajabi Stripe customers standardized at one row per customer.",
  tags: ["staging", "stripe_kajabi", "customers"],
}

select
  id as customer_id,
  nullif(lower(trim(email)), '') as email,
  nullif(trim(name), '') as name,
  nullif(trim(phone), '') as phone,
  description,
  created as customer_created_at,
  currency,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe_kajabi.customer`
qualify row_number() over (
  partition by id
  order by _fivetran_synced desc
) = 1
