config {
  type: "view",
  description: "Kajabi Stripe invoice line items standardized without cross-object joins.",
  tags: ["staging", "stripe_kajabi", "payments"],
}

select
  coalesce(nullif(trim(unique_id), ''), nullif(trim(id), '')) as line_item_id,
  invoice_id,
  subscription_id,
  subscription_item_id,
  price_id,
  plan_id,
  nullif(trim(description), '') as line_item_description,
  lower(currency) as currency,
  amount as amount_cents,
  cast(amount as numeric) / 100 as amount,
  quantity,
  period_start,
  period_end,
  proration,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe_kajabi.invoice_line_item`
qualify row_number() over (
  partition by coalesce(nullif(trim(unique_id), ''), nullif(trim(id), ''))
  order by _fivetran_synced desc
) = 1
