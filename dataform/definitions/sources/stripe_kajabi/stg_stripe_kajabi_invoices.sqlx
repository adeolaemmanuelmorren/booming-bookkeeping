config {
  type: "view",
  description: "Kajabi Stripe invoices standardized at one row per invoice.",
  tags: ["staging", "stripe_kajabi", "payments"],
}

select
  id as invoice_id,
  created as invoice_created_at,
  status,
  paid,
  billing_reason,
  customer_id,
  charge_id,
  payment_intent_id,
  subscription_id,
  lower(currency) as currency,
  amount_paid as amount_paid_cents,
  subtotal as subtotal_cents,
  total as total_cents,
  tax as tax_cents,
  amount_shipping as shipping_cents,
  nullif(trim(description), '') as description,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe_kajabi.invoice`
qualify row_number() over (
  partition by id
  order by _fivetran_synced desc
) = 1
