config {
  type: "view",
  description: "Kajabi Stripe PaymentIntents standardized at one row per PaymentIntent.",
  tags: ["staging", "stripe_kajabi", "payments"],
}

select
  id as payment_intent_id,
  created as payment_intent_created_at,
  lower(currency) as currency,
  amount as amount_cents,
  amount_received as amount_received_cents,
  status,
  customer_id,
  payment_method_id,
  nullif(lower(trim(receipt_email)), '') as receipt_email,
  nullif(trim(description), '') as description,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe_kajabi.payment_intent`
qualify row_number() over (
  partition by id
  order by _fivetran_synced desc
) = 1
