config {
  type: "view",
  description: "ActiveCampaign tag definitions standardized at one row per tag.",
  tags: ["staging", "activecampaign", "tags"],
}

select
  id as tag_id,
  nullif(trim(tags), '') as tag_name,
  c_date as tag_created_at,
  coalesce(_fivetran_deleted, false) as is_deleted
from `able-folio-499722.activecampaign.tags`
qualify row_number() over (
  partition by id
  order by _fivetran_synced desc
) = 1
