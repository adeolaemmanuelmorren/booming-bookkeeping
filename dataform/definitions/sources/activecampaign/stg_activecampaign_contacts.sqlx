config {
  type: "view",
  description: "ActiveCampaign contacts standardized at one row per contact.",
  tags: ["staging", "activecampaign", "contacts"],
}

select
  cast(id as string) as contact_id,
  nullif(lower(trim(email)), '') as email,
  nullif(trim(phone), '') as phone,
  nullif(trim(first_name), '') as first_name,
  nullif(trim(last_name), '') as last_name,
  nullif(trim(concat(coalesce(first_name, ''), ' ', coalesce(last_name, ''))), '') as full_name,
  c_date as contact_created_at,
  u_date as contact_updated_at,
  coalesce(_fivetran_deleted, false) as is_deleted
from `able-folio-499722.activecampaign.contact`
qualify row_number() over (
  partition by id
  order by _fivetran_synced desc
) = 1
