config {
  type: "view",
  description: "ActiveCampaign contact-tag assignments standardized as server-side form events.",
  tags: ["staging", "activecampaign", "tags", "forms"],
}

select
  cast(id as string) as contact_tag_id,
  cast(contact as string) as contact_id,
  cast(tags as string) as tag_id,
  c_date as assigned_at,
  coalesce(_fivetran_deleted, false) as is_deleted
from `able-folio-499722.activecampaign.contact_tag`
qualify row_number() over (
  partition by id
  order by _fivetran_synced desc
) = 1
