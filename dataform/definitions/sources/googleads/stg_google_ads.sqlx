config {
  type: "table",
  description: "Daily Google Ads performance at ad grain from the standardized ad-reporting output.",
  tags: ["staging", "google_ads", "ads"],
  bigquery: {
    clusterBy: ["campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  timestamp(date_day, "America/Los_Angeles") as time,
  cast(account_id as string) as account_id,
  nullif(trim(account_name), '') as account_name,
  cast(campaign_id as string) as campaign_id,
  nullif(trim(campaign_name), '') as campaign_name,
  cast(ad_group_id as string) as adset_id,
  nullif(trim(ad_group_name), '') as adset_name,
  cast(ad_id as string) as ad_id,
  nullif(trim(ad_name), '') as ad_name,
  cast(impressions as int64) as impressions,
  cast(clicks as int64) as clicks,
  cast(clicks as int64) as unique_clicks,
  cast(clicks as int64) as unique_inline_link_clicks,
  cast(spend as numeric) as spend,
  cast(conversions as numeric) as platform_conversions,
  cast(conversions_value as numeric) as platform_conversion_value,
  'USD' as currency
from `able-folio-499722.ad_reporting_google_ads_reports.ad_reporting__ad_report`
where date_day <= current_date("America/Los_Angeles")
