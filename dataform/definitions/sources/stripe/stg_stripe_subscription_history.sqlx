config {
  type: "view",
  description: "Stripe subscription history standardized while retaining Fivetran history rows.",
  tags: ["staging", "stripe", "subscriptions"],
}

select
  id as subscription_id,
  customer_id,
  status,
  created as subscription_created_at,
  start_date,
  current_period_start,
  current_period_end,
  cancel_at,
  canceled_at,
  ended_at,
  collection_method,
  default_payment_method_id,
  metadata,
  livemode,
  _fivetran_start,
  _fivetran_end,
  _fivetran_active as is_current_record,
  _fivetran_synced
from `able-folio-499722.stripe.subscription_history`

