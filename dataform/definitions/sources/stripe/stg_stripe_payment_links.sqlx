config {
  type: "view",
  description: "Stripe Payment Links standardized at one row per Payment Link.",
  tags: ["staging", "stripe", "payment_links"],
}

select
  id as payment_link_id,
  active,
  lower(currency) as currency,
  payment_intent_data_description as payment_description,
  subscription_data_description as subscription_description,
  allow_promotion_codes,
  submit_type,
  url,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe.payment_link`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

