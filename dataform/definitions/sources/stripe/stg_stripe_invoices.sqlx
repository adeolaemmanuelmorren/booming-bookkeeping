config {
  type: "view",
  description: "Stripe invoices standardized at one row per invoice.",
  tags: ["staging", "stripe", "invoices"],
}

select
  id as invoice_id,
  charge_id,
  payment_intent_id,
  customer_id,
  subscription_id,
  created as invoice_created_at,
  status_transitions_paid_at as invoice_paid_at,
  billing_reason,
  status,
  paid,
  attempted,
  attempt_count,
  collection_method,
  lower(currency) as currency,
  amount_due as amount_due_cents,
  cast(amount_due as numeric) / 100 as amount_due,
  amount_paid as amount_paid_cents,
  cast(amount_paid as numeric) / 100 as amount_paid,
  amount_remaining as amount_remaining_cents,
  cast(amount_remaining as numeric) / 100 as amount_remaining,
  subtotal as subtotal_cents,
  cast(subtotal as numeric) / 100 as subtotal,
  total as total_cents,
  cast(total as numeric) / 100 as total,
  description,
  number as invoice_number,
  period_start,
  period_end,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe.invoice`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

