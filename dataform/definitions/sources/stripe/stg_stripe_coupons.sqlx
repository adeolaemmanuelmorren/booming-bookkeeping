config {
  type: "view",
  description: "Stripe coupons standardized at one row per coupon.",
  tags: ["staging", "stripe", "discounts"],
}

select
  id as coupon_id,
  name as coupon_name,
  amount_off as amount_off_cents,
  cast(amount_off as numeric) / 100 as amount_off,
  percent_off,
  lower(currency) as currency,
  duration,
  duration_in_months,
  valid,
  created as coupon_created_at,
  redeem_by,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe.coupon`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

