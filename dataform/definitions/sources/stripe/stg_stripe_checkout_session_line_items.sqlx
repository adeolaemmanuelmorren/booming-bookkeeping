config {
  type: "view",
  description: "Stripe Checkout Session line items standardized at one row per line item.",
  tags: ["staging", "stripe", "checkout", "line_items"],
}

select
  id as checkout_line_item_id,
  checkout_session_id,
  price_id,
  description,
  quantity,
  lower(currency) as currency,
  cast(round(amount_subtotal) as int64) as amount_subtotal_cents,
  cast(round(amount_subtotal) as numeric) / 100 as amount_subtotal,
  cast(round(amount_total) as int64) as amount_total_cents,
  cast(round(amount_total) as numeric) / 100 as amount_total,
  amount_discount as discount_amount_cents,
  cast(amount_discount as numeric) / 100 as discount_amount,
  amount_tax as tax_amount_cents,
  cast(amount_tax as numeric) / 100 as tax_amount,
  _fivetran_synced
from `able-folio-499722.stripe.checkout_session_line_item`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

