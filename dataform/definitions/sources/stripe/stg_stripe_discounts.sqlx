config {
  type: "view",
  description: "Stripe discounts standardized at one row per discount application.",
  tags: ["staging", "stripe", "discounts"],
}

select
  id as discount_id,
  type as discount_type,
  type_id as discount_type_id,
  amount as discount_amount_cents,
  cast(amount as numeric) / 100 as discount_amount,
  coupon_id,
  promotion_code as promotion_code_id,
  customer_id,
  subscription_id,
  invoice_id,
  invoice_item_id,
  checkout_session_id,
  checkout_session_line_item_id,
  `start` as discount_started_at,
  `end` as discount_ended_at,
  _fivetran_synced
from `able-folio-499722.stripe.discount`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1
