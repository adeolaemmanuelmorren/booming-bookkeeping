config {
  type: "view",
  description: "Stripe Payment Link line items standardized at one row per line item.",
  tags: ["staging", "stripe", "payment_links", "line_items"],
}

select
  id as payment_link_line_item_id,
  payment_link_id,
  price_id,
  description,
  quantity,
  lower(currency) as currency,
  amount_subtotal as amount_subtotal_cents,
  cast(amount_subtotal as numeric) / 100 as amount_subtotal,
  amount_total as amount_total_cents,
  cast(amount_total as numeric) / 100 as amount_total,
  amount_discount as discount_amount_cents,
  cast(amount_discount as numeric) / 100 as discount_amount,
  amount_tax as tax_amount_cents,
  cast(amount_tax as numeric) / 100 as tax_amount,
  metadata,
  _fivetran_synced
from `able-folio-499722.stripe.payment_link_line_item`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

