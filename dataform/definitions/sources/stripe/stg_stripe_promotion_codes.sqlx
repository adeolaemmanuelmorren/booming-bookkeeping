config {
  type: "view",
  description: "Stripe promotion codes standardized at one row per promotion code.",
  tags: ["staging", "stripe", "discounts"],
}

select
  id as promotion_code_id,
  code as promotion_code,
  coupon_id,
  customer_id,
  active,
  first_time_transaction,
  minimum_amount as minimum_amount_cents,
  cast(minimum_amount as numeric) / 100 as minimum_amount,
  minimum_amount_currency,
  created as promotion_code_created_at,
  expires_at,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe.promotion_code`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

