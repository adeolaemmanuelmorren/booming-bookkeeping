config {
  type: "view",
  description: "Stripe customers standardized at one row per customer.",
  tags: ["staging", "stripe", "customers"],
}

select
  id as customer_id,
  lower(nullif(trim(email), '')) as email,
  nullif(trim(name), '') as name,
  nullif(trim(phone), '') as phone,
  description,
  created as customer_created_at,
  currency,
  address_city,
  address_country,
  address_line_1,
  address_line_2,
  address_postal_code,
  address_state,
  shipping_name,
  shipping_phone,
  shipping_address_city,
  shipping_address_country,
  shipping_address_line_1,
  shipping_address_line_2,
  shipping_address_postal_code,
  shipping_address_state,
  invoice_settings_default_payment_method as default_payment_method_id,
  delinquent,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe.customer`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

