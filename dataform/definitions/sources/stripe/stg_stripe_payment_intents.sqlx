config {
  type: "view",
  description: "Stripe PaymentIntents standardized without changing their source grain.",
  tags: ["staging", "stripe", "payments"],
}

select
  id as payment_intent_id,
  created as payment_intent_created_at,
  customer_id,
  payment_method_id,
  source_id,
  lower(currency) as currency,
  amount as amount_cents,
  cast(amount as numeric) / 100 as amount,
  amount_received as amount_received_cents,
  cast(amount_received as numeric) / 100 as amount_received,
  status,
  description,
  receipt_email,
  statement_descriptor,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe.payment_intent`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

