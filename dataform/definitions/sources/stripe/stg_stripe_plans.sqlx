config {
  type: "view",
  description: "Legacy Stripe plans standardized at one row per plan.",
  tags: ["staging", "stripe", "products", "subscriptions"],
}

select
  id as plan_id,
  product_id,
  active,
  lower(currency) as currency,
  amount as amount_cents,
  cast(amount as numeric) / 100 as amount,
  nickname,
  `interval`,
  interval_count,
  billing_scheme,
  usage_type,
  created as plan_created_at,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe.plan`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1
