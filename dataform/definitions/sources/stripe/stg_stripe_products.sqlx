config {
  type: "view",
  description: "Stripe products standardized at one row per product.",
  tags: ["staging", "stripe", "products"],
}

select
  id as product_id,
  nullif(trim(name), '') as product_name,
  description as product_description,
  statement_descriptor,
  active,
  type as product_type,
  created as product_created_at,
  updated as product_updated_at,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe.product`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

