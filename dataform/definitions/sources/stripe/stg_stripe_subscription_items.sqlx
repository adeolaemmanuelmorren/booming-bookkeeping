config {
  type: "view",
  description: "Stripe subscription items standardized at one row per subscription item.",
  tags: ["staging", "stripe", "subscriptions"],
}

select
  id as subscription_item_id,
  subscription_id,
  plan_id,
  quantity,
  created as subscription_item_created_at,
  current_period_start,
  current_period_end,
  metadata,
  _fivetran_synced
from `able-folio-499722.stripe.subscription_item`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

