config {
  type: "view",
  description: "Stripe prices standardized at one row per price.",
  tags: ["staging", "stripe", "products"],
}

select
  id as price_id,
  product_id,
  active,
  type as price_type,
  lower(currency) as currency,
  unit_amount as unit_amount_cents,
  cast(unit_amount as numeric) / 100 as unit_amount,
  nickname,
  recurring_interval,
  recurring_interval_count,
  recurring_usage_type,
  billing_scheme,
  lookup_key,
  created as price_created_at,
  metadata,
  livemode,
  is_deleted,
  _fivetran_synced
from `able-folio-499722.stripe.price`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

