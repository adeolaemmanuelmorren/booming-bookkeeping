config {
  type: "view",
  description: "Stripe Checkout Sessions standardized at one row per session.",
  tags: ["staging", "stripe", "checkout"],
}

select
  id as checkout_session_id,
  customer_id,
  payment_intent_id,
  subscription_id,
  payment_link as payment_link_id,
  client_reference_id,
  mode,
  status,
  payment_status,
  lower(currency) as currency,
  total_details_amount_discount as discount_amount_cents,
  cast(total_details_amount_discount as numeric) / 100 as discount_amount,
  total_details_amount_shipping as shipping_amount_cents,
  cast(total_details_amount_shipping as numeric) / 100 as shipping_amount,
  total_details_amount_tax as tax_amount_cents,
  cast(total_details_amount_tax as numeric) / 100 as tax_amount,
  allow_promotion_codes,
  success_url,
  cancel_url,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe.checkout_session`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1

