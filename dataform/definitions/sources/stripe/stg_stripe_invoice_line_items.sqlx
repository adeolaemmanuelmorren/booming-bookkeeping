config {
  type: "view",
  description: "Stripe invoice line items standardized at one row per invoice line item.",
  tags: ["staging", "stripe", "invoices", "line_items"],
}

select
  coalesce(nullif(unique_id, ''), id) as invoice_line_item_key,
  id as invoice_line_item_id,
  invoice_id,
  invoice_item_id,
  subscription_id,
  subscription_item_id,
  price_id,
  plan_id,
  description,
  quantity,
  lower(currency) as currency,
  amount as amount_cents,
  cast(amount as numeric) / 100 as amount,
  discountable,
  proration,
  period_start,
  period_end,
  metadata,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe.invoice_line_item`
qualify row_number() over (
  partition by coalesce(nullif(unique_id, ''), id)
  order by _fivetran_synced desc
) = 1

