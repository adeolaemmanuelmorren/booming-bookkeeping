config {
  type: "view",
  description: "Stripe charges standardized at one row per charge. Successful-payment filtering happens downstream.",
  tags: ["staging", "stripe", "payments"],
}

select
  id as charge_id,
  created as charge_created_at,
  lower(currency) as currency,
  amount as amount_cents,
  cast(amount as numeric) / 100 as amount,
  amount_captured as amount_captured_cents,
  cast(amount_captured as numeric) / 100 as amount_captured,
  amount_refunded as amount_refunded_cents,
  cast(amount_refunded as numeric) / 100 as amount_refunded,
  cast(amount - amount_refunded as numeric) / 100 as net_amount,
  paid,
  captured,
  refunded,
  status,
  customer_id,
  invoice_id,
  payment_intent_id,
  payment_method_id,
  source_id,
  receipt_email,
  receipt_number,
  receipt_url,
  billing_detail_email,
  billing_detail_name,
  billing_detail_phone,
  billing_detail_address_city,
  billing_detail_address_country,
  billing_detail_address_line_1,
  billing_detail_address_line_2,
  billing_detail_address_postal_code,
  billing_detail_address_state,
  shipping_address_city,
  shipping_address_country,
  shipping_address_line_1,
  shipping_address_line_2,
  shipping_address_postal_code,
  shipping_address_state,
  description,
  calculated_statement_descriptor,
  statement_descriptor,
  statement_descriptor_suffix,
  metadata,
  nullif(trim(json_value(metadata, '$.products')), '') as metadata_products,
  livemode,
  _fivetran_synced
from `able-folio-499722.stripe.charge`
qualify row_number() over (partition by id order by _fivetran_synced desc) = 1
