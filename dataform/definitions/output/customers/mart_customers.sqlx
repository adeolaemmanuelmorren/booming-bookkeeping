config {
  type: "table",
  description: "Resolved customer profiles with form and payment activity across Boom sources.",
  tags: ["output", "customers"],
}

with payment_rollup as (
  select
    profile_id,
    count(*) as successful_payments,
    countif(not is_repeat_payment) as initial_or_one_time_payments,
    min(payment_time) as first_payment_at,
    max(payment_time) as last_payment_at,
    sum(net_amount) as lifetime_net_revenue
  from ${ref("mart_payments")}
  where profile_id is not null
  group by profile_id
),

form_rollup as (
  select
    profile_id,
    count(*) as server_form_submissions,
    min(submitted_at) as first_server_form_at,
    max(submitted_at) as last_server_form_at
  from ${ref("mart_form_submissions_server_side")}
  where profile_id is not null
  group by profile_id
)

select
  profiles.profile_id,
  profiles.profile_key,
  profiles.anonymous_ids,
  profiles.user_ids,
  profiles.emails,
  profiles.phones,
  profiles.first_name,
  profiles.last_name,
  profiles.first_seen_at,
  profiles.last_seen_at,
  coalesce(forms.server_form_submissions, 0) as server_form_submissions,
  forms.first_server_form_at,
  forms.last_server_form_at,
  coalesce(payments.successful_payments, 0) as successful_payments,
  coalesce(payments.initial_or_one_time_payments, 0) as initial_or_one_time_payments,
  payments.first_payment_at,
  payments.last_payment_at,
  coalesce(payments.lifetime_net_revenue, 0) as lifetime_net_revenue
from ${ref("int_resolved_identifiers")} profiles
left join payment_rollup payments using (profile_id)
left join form_rollup forms using (profile_id)
