config {
  type: "table",
  description: "All website-session touchpoints with resolved profiles and paid click identifiers.",
  tags: ["output", "touchpoints", "attribution"],
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with anonymous_profiles as (
  select
    profile_id,
    anonymous_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(anonymous_ids) as anonymous_id
),

user_profiles as (
  select
    profile_id,
    user_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(user_ids) as user_id

  union distinct

  select
    profile_id,
    email as user_id
  from ${ref("int_resolved_identifiers")}
  cross join unnest(emails) as email
),

resolved as (
  select
    sessions.*,
    coalesce(anonymous_profiles.profile_id, user_profiles.profile_id) as profile_id
  from ${ref("mart_sessions")} sessions
  left join anonymous_profiles
    on sessions.anonymous_id = anonymous_profiles.anonymous_id
  left join user_profiles
    on lower(sessions.user_id) = user_profiles.user_id
  qualify row_number() over (
    partition by sessions.session_id
    order by coalesce(anonymous_profiles.profile_id, user_profiles.profile_id)
  ) = 1
)

select
  to_hex(md5(concat(session_id, '|website_session'))) as touchpoint_id,
  session_id,
  profile_id,
  visitor_key,
  anonymous_id,
  user_id,
  session_start_timestamp,
  session_start_timestamp as touchpoint_time,
  session_end_timestamp,
  session_duration_seconds,
  page_view_count,
  first_page_view_id,
  first_page_url,
  first_page_host,
  first_page_path,
  first_page_path_host,
  ip_address,
  user_agent,
  device_platform,
  device_is_mobile,
  geo_city,
  geo_region,
  geo_region_code,
  geo_country,
  geo_timezone,
  last_page_view_id,
  last_page_url,
  last_page_path,
  utm_source,
  utm_medium,
  utm_campaign,
  utm_content,
  utm_term,
  utm_id,
  campaign_id,
  adset_id,
  ad_id,
  google_keyword_id,
  google_keyword,
  click_id,
  click_id_type,
  gclid,
  gbraid,
  wbraid,
  fbclid,
  ttclid,
  li_fat_id,
  rdt_cid,
  twclid,
  fbc,
  fbp,
  ttp,
  uetsid,
  uetvid,
  channel_source,
  channel_medium,
  profile_id is not null as is_identified
from resolved
