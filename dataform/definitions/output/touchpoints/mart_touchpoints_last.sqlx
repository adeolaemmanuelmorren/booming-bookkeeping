config {
  type: "table",
  description: "Last observed website touchpoint per resolved profile.",
  tags: ["output", "touchpoints", "attribution"],
}

select * except (row_rank)
from (
  select
    *,
    row_number() over (
      partition by profile_id
      order by touchpoint_time desc, touchpoint_id desc
    ) as row_rank
  from ${ref("mart_touchpoints_all")}
  where profile_id is not null
)
where row_rank = 1
