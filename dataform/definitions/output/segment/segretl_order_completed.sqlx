config {
  type: "table",
  description: "New-order conversion payloads. Excludes renewals, later installments, and explicit balance payments.",
  tags: ["output", "segment", "reverse_etl", "conversions", "orders"],
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "event_name", "conversion_ts", "product_case", "product_id", "content_name", "value", "currency"],
    rowConditions: [
      "is_repeat_payment is false",
      "product_case in ('book', 'vip', 'mentorship', 'kajabi')",
      "array_length(content_ids) > 0",
    ],
  },
  bigquery: {
    clusterBy: ["payment_source", "product_case"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select *
from ${ref("segretl_repeatable_conversions")}
where is_repeat_payment is false
