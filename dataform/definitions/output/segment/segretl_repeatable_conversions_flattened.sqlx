config {
  type: "table",
  description: "Scalar-only version of segretl_repeatable_conversions for reverse-ETL destinations that cannot consume nested BigQuery fields.",
  tags: ["output", "segment", "reverse_etl", "conversions", "flattened"],
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "event_name", "conversion_ts"],
  },
  bigquery: {
    clusterBy: ["payment_source", "product_case"],
  },
}

select
  source.* except (
    address,
    content_ids,
    fb_content_ids,
    contents,
    fb_contents,
    click_ids,
    payload
  ),
  source.address.address_line_1 as address_line_1,
  source.address.city as address_city,
  source.address.region as address_region,
  source.address.zip as address_zip,
  source.address.country as address_country,
  to_json_string(source.content_ids) as content_ids_json,
  to_json_string(source.fb_content_ids) as fb_content_ids_json,
  to_json_string(source.contents) as contents_json,
  to_json_string(source.fb_contents) as fb_contents_json,
  source.click_ids.gclid as gclid,
  source.click_ids.wbraid as wbraid,
  source.click_ids.gbraid as gbraid,
  source.click_ids.fbclid as fbclid,
  source.click_ids.ttclid as ttclid,
  source.payload.event_name as payload_event_name,
  source.payload.event_id as payload_event_id,
  source.payload.event_time as payload_event_time,
  source.payload.product_case as payload_product_case,
  source.payload.product_id as payload_product_id,
  to_json_string(source.payload.content_ids) as payload_content_ids_json,
  to_json_string(source.payload.fb_content_ids) as payload_fb_content_ids_json,
  to_json_string(source.payload.fb_contents) as payload_fb_contents_json,
  source.payload.content_name as payload_content_name,
  source.payload.content_type as payload_content_type,
  source.payload.value as payload_value,
  source.payload.currency as payload_currency,
  source.payload.address.address_line_1 as payload_address_line_1,
  source.payload.address.city as payload_address_city,
  source.payload.address.region as payload_address_region,
  source.payload.address.zip as payload_address_zip,
  source.payload.address.country as payload_address_country
from ${ref("segretl_repeatable_conversions")} source
