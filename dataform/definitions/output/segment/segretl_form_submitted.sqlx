config {
  type: "table",
  description: "Server-side ActiveCampaign registration form conversions using the shared browser/server form mapping.",
  tags: ["output", "segment", "reverse_etl", "conversions", "forms"],
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "event_name", "conversion_ts", "email"],
  },
  bigquery: {
    clusterBy: ["registration_type", "registration_tag_type"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with mapped_form_submissions as (
  select
    profile_id,
    form_submission_id,
    contact_id,
    tag_id,
    tag_name,
    registration_tag_type,
    lower(trim(email)) as email,
    phone,
    first_name as profile_first_name,
    last_name as profile_last_name,
    submitted_at as conversion_ts,
    registration_type,
    content_name,
    canonical_event_id as event_id,
    form_type,
    event_source
  from ${ref("mart_form_submissions_server_side")}
  where email is not null
    and submitted_at is not null
    and canonical_event_id is not null
  qualify row_number() over (
    partition by canonical_event_id
    order by submitted_at, form_submission_id
  ) = 1
),

pre_conversion_click_ids as (
  select
    forms.event_id,
    array_agg(touchpoints.anonymous_id ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as anonymous_id,
    array_agg(touchpoints.gclid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as gclid,
    array_agg(touchpoints.wbraid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as wbraid,
    array_agg(touchpoints.gbraid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as gbraid,
    array_agg(touchpoints.fbclid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as fbclid,
    array_agg(
      touchpoints.fbc_fbclid
      ignore nulls
      order by touchpoints.touchpoint_time desc, touchpoints.touchpoint_id desc
      limit 1
    )[safe_offset(0)] as latest_preconversion_fbc_fbclid,
    array_agg(touchpoints.ttclid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as ttclid
  from mapped_form_submissions forms
  left join ${ref("mart_touchpoints_all")} touchpoints
    on touchpoints.profile_id = forms.profile_id
   and touchpoints.touchpoint_time <= forms.conversion_ts
  group by forms.event_id
),

pre_conversion_meta_ids as (
  select
    forms.event_id,
    array_agg(
      attribution.fbc
      ignore nulls
      order by attribution.event_time desc, attribution.event_id desc
      limit 1
    )[safe_offset(0)] as latest_preconversion_fbc,
    array_agg(
      attribution.fbp
      ignore nulls
      order by attribution.event_time desc, attribution.event_id desc
      limit 1
    )[safe_offset(0)] as latest_preconversion_fbp
  from mapped_form_submissions forms
  left join ${ref("int_attribution_events")} attribution
    on attribution.profile_id = forms.profile_id
   and attribution.event_time <= forms.conversion_ts
  group by forms.event_id
),

attribution_traits as (
  select *
  from ${ref("int_attribution_traits")}
)

select
  forms.profile_id,
  clicks.anonymous_id,
  forms.form_submission_id,
  forms.contact_id,
  forms.tag_id,
  forms.tag_name,
  forms.registration_tag_type,
  forms.event_id,
  'CompleteRegistration' as event_name,
  forms.conversion_ts,
  forms.email,
  forms.phone,
  forms.profile_first_name,
  forms.profile_last_name,
  forms.registration_type,
  forms.content_name,
  forms.form_type,
  forms.event_source,
  struct(
    clicks.gclid as gclid,
    case when clicks.gclid is null then clicks.wbraid end as wbraid,
    case when clicks.gclid is null and clicks.wbraid is null then clicks.gbraid end as gbraid,
    clicks.fbclid as fbclid,
    clicks.ttclid as ttclid
  ) as click_ids,
  coalesce(
    meta.latest_preconversion_fbc,
    clicks.latest_preconversion_fbc_fbclid
  ) as pre_conversion_fbc,
  meta.latest_preconversion_fbp as pre_conversion_fbp,
  case
    when clicks.gclid is not null
      or (clicks.gclid is null and clicks.wbraid is null and clicks.gbraid is null)
      then forms.email
  end as compliant_email,
  case
    when clicks.gclid is not null
      or (clicks.gclid is null and clicks.wbraid is null and clicks.gbraid is null)
      then forms.phone
  end as compliant_phone,
  (
    clicks.gclid is not null
    or clicks.wbraid is not null
    or clicks.gbraid is not null
    or clicks.fbclid is not null
    or clicks.ttclid is not null
  ) as is_click,
  coalesce(traits.first_known_ip_address, '127.0.0.1') as first_known_ip_address,
  coalesce(traits.last_known_ip_address, '127.0.0.1') as last_known_ip_address,
  coalesce(
    traits.first_known_user_agent,
    'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
  ) as first_known_user_agent,
  coalesce(
    traits.last_known_user_agent,
    'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
  ) as last_known_user_agent,
  traits.first_known_geo_city,
  traits.first_known_geo_region,
  traits.first_known_geo_country,
  traits.last_known_geo_city,
  traits.last_known_geo_region,
  traits.last_known_geo_country,
  traits.first_known_fbc,
  traits.first_known_fbp,
  traits.first_known_uetsid,
  traits.first_known_uetvid,
  traits.last_known_fbc,
  traits.last_known_fbp,
  traits.last_known_uetsid,
  traits.last_known_uetvid,
  struct(
    'CompleteRegistration' as event_name,
    forms.event_id as event_id,
    forms.conversion_ts as event_time,
    forms.content_name as content_name
  ) as payload
from mapped_form_submissions forms
left join pre_conversion_click_ids clicks
  using (event_id)
left join pre_conversion_meta_ids meta
  using (event_id)
left join attribution_traits traits
  using (profile_id)
