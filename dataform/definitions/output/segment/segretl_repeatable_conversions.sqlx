config {
  type: "table",
  description: "Eligible Stripe Purchase conversion payloads using deterministic event IDs and normalized product content.",
  tags: ["output", "segment", "reverse_etl", "conversions"],
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "event_name", "conversion_ts", "product_case", "product_id", "content_name", "value", "currency"],
    rowConditions: [
      "product_case in ('book', 'vip', 'mentorship', 'kajabi')",
      "array_length(content_ids) > 0",
    ],
  },
  bigquery: {
    clusterBy: ["payment_source", "product_case"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with resolved_payments as (
  select
    payments.* except (
      content_ids,
      product_id,
      product_name,
      product_complete_name,
      product_rule,
      product_classification_method,
      is_product_classified
    ),
    products.product_id,
    products.product_name,
    products.product_name as product_complete_name,
    products.content_ids as conversion_content_ids,
    products.product_resolution_source
  from ${ref("mart_payments")} payments
  join ${ref("int_stripe_browser_product_resolution")} products
    using (payment_source, payment_id)
  where not payments.is_repeat_payment
    and payments.payment_time >= timestamp_sub(current_timestamp(), interval 90 day)
),

classified_payments as (
  select
    *,
    case
      when payment_source = 'stripe_kajabi'
        and exists (
          select 1
          from unnest(conversion_content_ids) content_id
          where regexp_contains(content_id, r'booming bookkeeping mentorship program')
        )
        then 'kajabi'
      when exists (
        select 1
        from unnest(conversion_content_ids) content_id
        where regexp_contains(content_id, r'(keyboard rich book|top tax loopholes)')
      )
        then 'book'
      when exists (
        select 1
        from unnest(conversion_content_ids) content_id
        where regexp_contains(content_id, r'(vip|keyboard rich challenge)')
      )
        then 'vip'
      when payment_source = 'stripe'
        and exists (
          select 1
          from unnest(conversion_content_ids) content_id
          where regexp_contains(content_id, r'booming bookkeeping mentorship program')
        )
        then 'mentorship'
    end as product_case
  from resolved_payments
),

eligible_payments as (
  select *
  from classified_payments
  where product_case is not null
    and array_length(conversion_content_ids) > 0
),

event_ids as (
  select
    *,
    concat('purchase_', payment_id) as event_id
  from eligible_payments
),

payment_events as (
  select
    *,
    product_complete_name as content_name,
    'product' as content_type,
    amount_paid as value,
    upper(currency) as conversion_currency,
    array_length(conversion_content_ids) as num_items,
    array(
      select as struct
        content_id as id,
        1 as quantity,
        safe_divide(amount_paid, nullif(array_length(conversion_content_ids), 0)) as item_price
      from unnest(conversion_content_ids) content_id
    ) as contents
  from event_ids
  where event_id is not null
  qualify row_number() over (
    partition by event_id
    order by payment_time, payment_source, payment_id
  ) = 1
),

pre_conversion_click_ids as (
  select
    payments.payment_source,
    payments.payment_id,
    array_agg(touchpoints.gclid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as gclid,
    array_agg(touchpoints.wbraid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as wbraid,
    array_agg(touchpoints.gbraid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as gbraid,
    array_agg(touchpoints.fbclid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as fbclid,
    array_agg(touchpoints.ttclid ignore nulls order by touchpoints.touchpoint_time desc)[safe_offset(0)] as ttclid
  from payment_events payments
  left join ${ref("mart_touchpoints_all")} touchpoints
    on touchpoints.profile_id = payments.profile_id
   and touchpoints.touchpoint_time <= payments.payment_time
  group by payments.payment_source, payments.payment_id
),

customer_profiles as (
  select
    profile_id,
    first_name,
    last_name
  from ${ref("mart_customers")}
),

attribution_traits as (
  select *
  from ${ref("int_attribution_traits")}
)

select
  payments.payment_source,
  payments.payment_id,
  payments.profile_id,
  payments.event_id,
  'Purchase' as event_name,
  payments.payment_time as conversion_ts,
  payments.payment_email as email,
  payments.payment_phone as phone,
  coalesce(profiles.first_name, split(payments.payment_name, ' ')[safe_offset(0)]) as profile_first_name,
  profiles.last_name as profile_last_name,
  payments.product_case,
  payments.product_resolution_source,
  payments.product_id,
  payments.payment_occurrence_type,
  payments.is_repeat_payment,
  payments.conversion_content_ids as content_ids,
  payments.conversion_content_ids as fb_content_ids,
  payments.content_name,
  payments.content_type,
  payments.value,
  payments.conversion_currency as currency,
  payments.num_items,
  payments.contents,
  payments.contents as fb_contents,
  struct(
    clicks.gclid as gclid,
    case when clicks.gclid is null then clicks.wbraid end as wbraid,
    case when clicks.gclid is null and clicks.wbraid is null then clicks.gbraid end as gbraid,
    clicks.fbclid as fbclid,
    clicks.ttclid as ttclid
  ) as click_ids,
  case
    when clicks.gclid is not null
      or (clicks.gclid is null and clicks.wbraid is null and clicks.gbraid is null)
      then payments.payment_email
  end as compliant_email,
  case
    when clicks.gclid is not null
      or (clicks.gclid is null and clicks.wbraid is null and clicks.gbraid is null)
      then payments.payment_phone
  end as compliant_phone,
  (
    clicks.gclid is not null
    or clicks.wbraid is not null
    or clicks.gbraid is not null
    or clicks.fbclid is not null
    or clicks.ttclid is not null
  ) as is_click,
  coalesce(traits.first_known_ip_address, '127.0.0.1') as first_known_ip_address,
  coalesce(traits.last_known_ip_address, '127.0.0.1') as last_known_ip_address,
  coalesce(
    traits.first_known_user_agent,
    'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
  ) as first_known_user_agent,
  coalesce(
    traits.last_known_user_agent,
    'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
  ) as last_known_user_agent,
  traits.first_known_geo_city,
  traits.first_known_geo_region,
  traits.first_known_geo_country,
  traits.last_known_geo_city,
  traits.last_known_geo_region,
  traits.last_known_geo_country,
  traits.first_known_fbc,
  traits.first_known_fbp,
  traits.first_known_uetsid,
  traits.first_known_uetvid,
  traits.last_known_fbc,
  traits.last_known_fbp,
  traits.last_known_uetsid,
  traits.last_known_uetvid,
  struct(
    'Purchase' as event_name,
    payments.event_id as event_id,
    payments.payment_time as event_time,
    payments.product_case as product_case,
    payments.product_id as product_id,
    payments.conversion_content_ids as content_ids,
    payments.conversion_content_ids as fb_content_ids,
    payments.contents as fb_contents,
    payments.content_name as content_name,
    payments.content_type as content_type,
    payments.value as value,
    payments.conversion_currency as currency
  ) as payload
from payment_events payments
left join pre_conversion_click_ids clicks
  using (payment_source, payment_id)
left join customer_profiles profiles
  using (profile_id)
left join attribution_traits traits
  using (profile_id)
