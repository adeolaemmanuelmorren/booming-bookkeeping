config {
  type: "table",
  description: "Scalar-only version of segretl_form_submitted for reverse-ETL destinations that cannot consume nested BigQuery fields.",
  tags: ["output", "segment", "reverse_etl", "conversions", "forms", "flattened"],
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "event_name", "conversion_ts"],
  },
  bigquery: {
    clusterBy: ["registration_type", "registration_tag_type"],
  },
}

select
  source.* except (click_ids, payload),
  source.click_ids.gclid as gclid,
  source.click_ids.wbraid as wbraid,
  source.click_ids.gbraid as gbraid,
  source.click_ids.fbclid as fbclid,
  source.click_ids.ttclid as ttclid,
  source.payload.event_name as payload_event_name,
  source.payload.event_id as payload_event_id,
  source.payload.event_time as payload_event_time,
  source.payload.content_name as payload_content_name
from ${ref("segretl_form_submitted")} source
