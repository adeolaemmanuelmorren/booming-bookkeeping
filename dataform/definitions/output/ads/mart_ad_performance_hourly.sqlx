config {
  type: "table",
  description: "Hourly Meta ad performance for additive delivery metrics.",
  tags: ["output", "ads", "performance", "hourly"],
  assertions: {
    uniqueKey: ["hour_start", "source", "account_id", "ad_id"],
    nonNull: [
      "hour_start",
      "date",
      "source",
      "account_id",
      "campaign_id",
      "adset_id",
      "ad_id",
      "spend",
    ],
    rowConditions: [
      "impressions >= 0",
      "clicks >= 0",
      "spend >= 0",
    ],
  },
  bigquery: {
    clusterBy: ["source", "campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  hour_start,
  date,
  hour_bucket,
  hour_breakdown_type,
  account_id,
  account_name,
  'meta' as source,
  'Meta Ads' as formatted_source,
  campaign_id,
  campaign_name,
  adset_id,
  adset_name,
  ad_id,
  ad_name,
  impressions,
  clicks,
  spend,
  currency
from ${ref("stg_facebook_ads_hourly")}
