config {
  type: "table",
  description: "Unified Google and Meta daily ad performance using a common hierarchy.",
  tags: ["output", "ads", "performance"],
  bigquery: {
    clusterBy: ["source", "campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  time,
  account_id,
  account_name,
  'google' as source,
  'Google Ads' as formatted_source,
  campaign_id,
  campaign_name,
  adset_id,
  adset_name,
  ad_id,
  ad_name,
  impressions,
  clicks,
  unique_clicks,
  unique_inline_link_clicks,
  spend,
  platform_conversions,
  platform_conversion_value,
  currency
from ${ref("stg_google_ads")}

union all

select
  time,
  account_id,
  account_name,
  'meta' as source,
  'Meta Ads' as formatted_source,
  campaign_id,
  campaign_name,
  adset_id,
  adset_name,
  ad_id,
  ad_name,
  impressions,
  clicks,
  unique_clicks,
  unique_inline_link_clicks,
  spend,
  platform_conversions,
  platform_conversion_value,
  currency
from ${ref("stg_facebook_ads")}
