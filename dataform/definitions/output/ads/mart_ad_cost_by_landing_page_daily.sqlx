config {
  type: "table",
  description: "Google and Meta daily ad cost grouped by the platform-reported landing page.",
  tags: ["output", "ads", "landing_pages"],
  bigquery: {
    clusterBy: ["source", "landing_page_host_normalized", "landing_page_path"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with source_rows as (
  select
    date_day as date,
    'google' as source,
    'Google Ads' as formatted_source,
    cast(account_id as string) as account_id,
    cast(campaign_id as string) as campaign_id,
    campaign_name,
    cast(ad_group_id as string) as adset_id,
    ad_group_name as adset_name,
    base_url as landing_page_url,
    url_host as landing_page_host,
    url_path as landing_page_path,
    cast(impressions as int64) as impressions,
    cast(clicks as int64) as unique_clicks,
    cast(spend as numeric) as spend
  from `able-folio-499722.ad_reporting_google_ads_reports.ad_reporting__url_report`

  union all

  select
    date_day as date,
    'meta' as source,
    'Meta Ads' as formatted_source,
    cast(account_id as string) as account_id,
    cast(campaign_id as string) as campaign_id,
    campaign_name,
    cast(ad_group_id as string) as adset_id,
    ad_group_name as adset_name,
    base_url as landing_page_url,
    url_host as landing_page_host,
    url_path as landing_page_path,
    cast(impressions as int64) as impressions,
    cast(clicks as int64) as unique_clicks,
    cast(spend as numeric) as spend
  from `able-folio-499722.ad_reporting_reports.ad_reporting__url_report`
  where platform = 'facebook_ads'
),

normalized as (
  select
    *,
    nullif(trim(landing_page_url), '') is not null as has_landing_page_url,
    regexp_replace(lower(coalesce(nullif(trim(landing_page_host), ''), 'unknown')), r'^www\.', '')
      as landing_page_host_normalized,
    coalesce(nullif(trim(landing_page_path), ''), '/') as landing_page_path_normalized
  from source_rows
  where date <= current_date("America/Los_Angeles")
)

select
  date,
  source,
  formatted_source,
  account_id,
  campaign_id,
  campaign_name,
  adset_id,
  adset_name,
  landing_page_url,
  has_landing_page_url,
  coalesce(nullif(trim(landing_page_host), ''), 'unknown') as landing_page_host,
  landing_page_host_normalized,
  landing_page_path_normalized as landing_page_path,
  concat(landing_page_host_normalized, landing_page_path_normalized) as landing_page_normalized,
  sum(impressions) as impressions,
  sum(unique_clicks) as unique_clicks,
  sum(unique_clicks) as unique_inline_link_clicks,
  sum(spend) as spend,
  'USD' as currency
from normalized
group by
  date,
  source,
  formatted_source,
  account_id,
  campaign_id,
  campaign_name,
  adset_id,
  adset_name,
  landing_page_url,
  has_landing_page_url,
  landing_page_host,
  landing_page_host_normalized,
  landing_page_path_normalized
