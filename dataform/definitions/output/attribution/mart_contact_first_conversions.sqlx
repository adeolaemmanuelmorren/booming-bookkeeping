config {
  type: "table",
  description: "First server-side challenge registration per resolved profile.",
  tags: ["output", "attribution", "conversions"],
}

select
  profile_id,
  email as profile_email,
  phone as profile_phone,
  first_name as profile_first_name,
  last_name as profile_last_name,
  form_submission_id,
  submitted_at as form_submit_time,
  tag_name,
  registration_type,
  content_name,
  canonical_event_id
from ${ref("mart_form_submissions_server_side")}
where profile_id is not null
  and email is not null
qualify row_number() over (
  partition by profile_id, registration_type
  order by submitted_at, form_submission_id
) = 1
