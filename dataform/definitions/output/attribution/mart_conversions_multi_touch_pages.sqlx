config {
  type: "view",
  description: "Multi-touch conversion metrics rolled up to the landing-page and click-date grain.",
  tags: ["output", "attribution", "landing_pages"],
}

js {
  const metrics = [
    "form_submissions_server_side",
    "form_submissions_client_side",
    "order_completed_server_side",
    "order_completed_client_side",
    "payments_server_side",
    "payments_client_side",
    "revenue_server_side",
    "revenue_client_side",
    "customers_server_side",
  ];
}

select
  click_date,
  landing_page_host,
  landing_page_path,
  sum(sessions) as sessions,
  ${
    metrics
      .flatMap((metric) => ["mt", "ft", "lt"].map(
        (suffix) => `sum(${metric}_${suffix}) as ${metric}_${suffix}`
      ))
      .join(",\n  ")
  }
from ${ref("mart_conversions_multi_touch")}
group by click_date, landing_page_host, landing_page_path
