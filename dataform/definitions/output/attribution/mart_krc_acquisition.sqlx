config {
  type: "table",
  description: "Latest applicable KRC registration per profile with Meta first-touch, last-touch, and solo-touch acquisition plus Immediate VIP and first $5K outcomes. For buyers, the latest registration before the first qualifying $5K purchase is used; otherwise, the latest registration overall is used.",
  tags: ["output", "attribution", "krc", "meta_ads"],
  assertions: {
    uniqueKey: ["registration_id"],
    nonNull: ["registration_id", "profile_id", "registration_timestamp"],
    rowConditions: [
      "pre_registration_paid_click_count >= 0",
      "not is_solo_touch or pre_registration_paid_click_count = 1",
      "not is_immediate_vip or immediate_vip_payment_id is not null",
      "not is_5k_purchaser or first_5k_payment_id is not null",
    ],
  },
  bigquery: {
    clusterBy: ["last_touch_campaign_id", "last_touch_adset_id", "last_touch_ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const { reportingTimeZone } = require("includes/reporting_time");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with krc_registrations as (
  select
    form_submission_id as registration_id,
    profile_id,
    submitted_at as registration_timestamp,
    date(submitted_at, "${reportingTimeZone}") as registration_date
  from ${ref("mart_form_submissions_server_side")}
  where registration_type = 'krc'
    and profile_id is not null
    and submitted_at is not null
),

earliest_registration as (
  select
    profile_id,
    min(registration_timestamp) as registration_timestamp
  from krc_registrations
  group by profile_id
),

first_5k_by_profile as (
  select
    payments.profile_id,
    payments.payment_id,
    payments.payment_time,
    payments.net_amount
  from ${ref("mart_payments")} payments
  join earliest_registration registrations
    on registrations.profile_id = payments.profile_id
   and payments.payment_time >= registrations.registration_timestamp
  where payments.payment_category = 'mentorship'
    and not payments.is_repeat_payment
    and payments.net_amount > 900
  qualify row_number() over (
    partition by payments.profile_id
    order by payments.payment_time, payments.payment_id
  ) = 1
),

selected_registration as (
  select registrations.*
  from krc_registrations registrations
  left join first_5k_by_profile purchases
    using (profile_id)
  where purchases.payment_time is null
     or registrations.registration_timestamp <= purchases.payment_time
  qualify row_number() over (
    partition by registrations.profile_id
    order by registrations.registration_timestamp desc, registrations.registration_id desc
  ) = 1
),

latest_ad_names as (
  select
    campaign_id,
    adset_id,
    ad_id,
    array_agg(campaign_name ignore nulls order by time desc limit 1)[safe_offset(0)] as campaign_name,
    array_agg(adset_name ignore nulls order by time desc limit 1)[safe_offset(0)] as adset_name,
    array_agg(ad_name ignore nulls order by time desc limit 1)[safe_offset(0)] as ad_name
  from ${ref("mart_ad_performance")}
  where source = 'meta'
  group by campaign_id, adset_id, ad_id
),

meta_paid_clicks as (
  select
    touchpoints.touchpoint_id,
    touchpoints.profile_id,
    touchpoints.touchpoint_time as click_timestamp,
    timestamp_trunc(
      touchpoints.touchpoint_time,
      hour,
      "${reportingTimeZone}"
    ) as click_hour,
    date(touchpoints.touchpoint_time, "${reportingTimeZone}") as click_date,
    touchpoints.campaign_id,
    touchpoints.adset_id,
    touchpoints.ad_id,
    coalesce(names.campaign_name, touchpoints.utm_campaign, 'Unknown campaign') as campaign_name,
    coalesce(names.adset_name, 'Unknown ad set') as adset_name,
    coalesce(names.ad_name, touchpoints.utm_content, 'Unknown ad') as ad_name
  from ${ref("mart_touchpoints_all")} touchpoints
  left join latest_ad_names names
    on names.campaign_id is not distinct from touchpoints.campaign_id
   and names.adset_id is not distinct from touchpoints.adset_id
   and names.ad_id is not distinct from touchpoints.ad_id
  where touchpoints.profile_id is not null
    and touchpoints.touchpoint_time is not null
    -- stg_page_views is the canonical classifier. A Meta visit with only
    -- fbclid is meta / social and must not be promoted to paid here.
    and lower(coalesce(
      nullif(trim(touchpoints.utm_source), ''),
      nullif(trim(touchpoints.channel_source), ''),
      ''
    )) = 'meta'
    and lower(coalesce(
      nullif(trim(touchpoints.utm_medium), ''),
      nullif(trim(touchpoints.channel_medium), ''),
      ''
    )) = 'paid'
),

pre_registration_clicks as (
  select
    registrations.registration_id,
    clicks.* except (profile_id)
  from selected_registration registrations
  join meta_paid_clicks clicks
    on clicks.profile_id = registrations.profile_id
   and clicks.click_timestamp < registrations.registration_timestamp
),

click_rollup as (
  select
    registration_id,
    count(*) as pre_registration_paid_click_count,
    array_agg(
      struct(
        touchpoint_id,
        click_timestamp,
        click_hour,
        click_date,
        campaign_id,
        adset_id,
        ad_id,
        campaign_name,
        adset_name,
        ad_name
      )
      order by click_timestamp, touchpoint_id
    ) as pre_registration_paid_click_path,
    array_agg(
      struct(
        touchpoint_id,
        click_timestamp,
        click_hour,
        click_date,
        campaign_id,
        adset_id,
        ad_id,
        campaign_name,
        adset_name,
        ad_name
      )
      order by click_timestamp, touchpoint_id
      limit 1
    )[safe_offset(0)] as first_touch,
    array_agg(
      struct(
        touchpoint_id,
        click_timestamp,
        click_hour,
        click_date,
        campaign_id,
        adset_id,
        ad_id,
        campaign_name,
        adset_name,
        ad_name
      )
      order by click_timestamp desc, touchpoint_id desc
      limit 1
    )[safe_offset(0)] as last_touch
  from pre_registration_clicks
  group by registration_id
),

immediate_vip_outcomes as (
  select
    registrations.registration_id,
    array_agg(
      struct(
        payments.payment_id,
        payments.payment_time,
        payments.net_amount
      )
      order by payments.payment_time, payments.payment_id
      limit 1
    )[safe_offset(0)] as immediate_vip
  from selected_registration registrations
  join ${ref("mart_payments")} payments
    on payments.profile_id = registrations.profile_id
   and payments.payment_time >= registrations.registration_timestamp
   and date(payments.payment_time, "${reportingTimeZone}") = registrations.registration_date
  where payments.product_rule in (
      'keyboard_rich_challenge_vip',
      'structured_basic_vip'
    )
    and not payments.is_repeat_payment
  group by registrations.registration_id
)

select
  registrations.registration_id,
  registrations.profile_id,
  registrations.registration_timestamp,
  registrations.registration_date,
  coalesce(clicks.pre_registration_paid_click_count, 0) as pre_registration_paid_click_count,
  coalesce(
    clicks.pre_registration_paid_click_path,
    []
  ) as pre_registration_paid_click_path,
  coalesce(clicks.pre_registration_paid_click_count, 0) = 1 as is_solo_touch,
  clicks.first_touch.touchpoint_id as first_touch_touchpoint_id,
  clicks.first_touch.click_timestamp as first_touch_click_timestamp,
  clicks.first_touch.click_hour as first_touch_click_hour,
  clicks.first_touch.click_date as first_touch_click_date,
  clicks.first_touch.campaign_id as first_touch_campaign_id,
  clicks.first_touch.adset_id as first_touch_adset_id,
  clicks.first_touch.ad_id as first_touch_ad_id,
  clicks.first_touch.campaign_name as first_touch_campaign_name,
  clicks.first_touch.adset_name as first_touch_adset_name,
  clicks.first_touch.ad_name as first_touch_ad_name,
  clicks.last_touch.touchpoint_id as last_touch_touchpoint_id,
  clicks.last_touch.click_timestamp as last_touch_click_timestamp,
  clicks.last_touch.click_hour as last_touch_click_hour,
  clicks.last_touch.click_date as last_touch_click_date,
  clicks.last_touch.campaign_id as last_touch_campaign_id,
  clicks.last_touch.adset_id as last_touch_adset_id,
  clicks.last_touch.ad_id as last_touch_ad_id,
  clicks.last_touch.campaign_name as last_touch_campaign_name,
  clicks.last_touch.adset_name as last_touch_adset_name,
  clicks.last_touch.ad_name as last_touch_ad_name,
  immediate.immediate_vip.payment_id as immediate_vip_payment_id,
  immediate.immediate_vip.payment_time as immediate_vip_payment_timestamp,
  immediate.immediate_vip.net_amount as immediate_vip_revenue,
  immediate.immediate_vip.payment_id is not null as is_immediate_vip,
  five_k.payment_id as first_5k_payment_id,
  five_k.payment_time as first_5k_payment_timestamp,
  five_k.net_amount as first_5k_revenue,
  five_k.payment_id is not null as is_5k_purchaser
from selected_registration registrations
left join click_rollup clicks
  using (registration_id)
left join immediate_vip_outcomes immediate
  using (registration_id)
left join first_5k_by_profile five_k
  using (profile_id)
