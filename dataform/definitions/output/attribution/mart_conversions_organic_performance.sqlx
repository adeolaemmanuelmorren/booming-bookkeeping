config {
  type: "table",
  description: "Non-paid session traffic joined to warehouse-attributed client/server conversions by click date.",
  tags: ["output", "attribution", "organic", "conversions"],
  bigquery: {
    clusterBy: ["source", "medium"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const metrics = [
    "form_submissions_server_side",
    "krc_registrations_server_side",
    "form_submissions_client_side",
    "order_completed_server_side",
    "order_completed_client_side",
    "payments_server_side",
    "payments_client_side",
    "revenue_server_side",
    "revenue_client_side",
    "customers_server_side",
    "bbb_buyers_server_side",
    "bbb_revenue_server_side",
    "payments_vip_server_side",
    "payments_book_server_side",
    "payments_mentorship_server_side",
    "payments_kajabi_server_side",
    "payments_catalog_server_side",
    "payments_unknown_server_side",
    "revenue_vip_server_side",
    "revenue_book_server_side",
    "revenue_mentorship_server_side",
    "revenue_kajabi_server_side",
    "revenue_catalog_server_side",
    "revenue_unknown_server_side",
  ];
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with sessions as (
  select
    date(session_start_timestamp, "America/Los_Angeles") as date,
    coalesce(utm_source, channel_source, 'unknown') as source,
    coalesce(utm_medium, channel_medium, 'unknown') as medium,
    coalesce(utm_campaign, 'unknown') as campaign_name,
    coalesce(utm_content, 'unknown') as secondary_drill_down,
    coalesce(utm_term, 'unknown') as tertiary_drill_down,
    count(*) as unique_clicks
  from ${ref("mart_sessions")}
  where coalesce(utm_medium, channel_medium, 'unknown') not in ('cpc', 'paid', 'paid_social')
  group by date, source, medium, campaign_name, secondary_drill_down, tertiary_drill_down
),

conversions as (
  select
    click_date as date,
    source,
    medium,
    campaign_name,
    utm_content as secondary_drill_down,
    utm_term as tertiary_drill_down,
    ${
      metrics
        .flatMap((metric) => ["mt", "ft", "lt"].map(
          (suffix) => `sum(${metric}_${suffix}) as ${metric}_${suffix}`
        ))
        .join(",\n    ")
    }
  from ${ref("mart_conversions_multi_touch")}
  where medium not in ('cpc', 'paid', 'paid_social')
  group by date, source, medium, campaign_name, secondary_drill_down, tertiary_drill_down
)

select
  coalesce(sessions.date, conversions.date) as date,
  coalesce(sessions.source, conversions.source, 'unknown') as source,
  coalesce(sessions.medium, conversions.medium, 'unknown') as medium,
  coalesce(sessions.campaign_name, conversions.campaign_name, 'unknown') as campaign_name,
  cast(null as string) as adset_name,
  cast(null as string) as ad_name,
  coalesce(sessions.secondary_drill_down, conversions.secondary_drill_down, 'unknown') as secondary_drill_down,
  coalesce(sessions.tertiary_drill_down, conversions.tertiary_drill_down, 'unknown') as tertiary_drill_down,
  'USD' as currency,
  0 as impressions,
  coalesce(sessions.unique_clicks, 0) as clicks,
  coalesce(sessions.unique_clicks, 0) as unique_clicks,
  0 as unique_inline_link_clicks,
  cast(null as string) as campaign_id,
  cast(null as string) as adset_id,
  cast(null as string) as ad_id,
  cast(0 as numeric) as spend,
  cast(0 as numeric) as platform_conversions,
  cast(0 as numeric) as platform_conversion_value,
  ${
    metrics
      .flatMap((metric) => ["mt", "ft", "lt"].map(
        (suffix) => `coalesce(conversions.${metric}_${suffix}, 0) as ${metric}_${suffix}`
      ))
      .join(",\n  ")
  }
from sessions
full outer join conversions
  on sessions.date = conversions.date
 and sessions.source = conversions.source
 and sessions.medium = conversions.medium
 and sessions.campaign_name = conversions.campaign_name
 and sessions.secondary_drill_down = conversions.secondary_drill_down
 and sessions.tertiary_drill_down = conversions.tertiary_drill_down
