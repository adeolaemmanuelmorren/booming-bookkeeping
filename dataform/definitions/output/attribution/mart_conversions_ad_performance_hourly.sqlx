config {
  type: "table",
  description: "Hourly Meta spend joined to warehouse-attributed conversions by click hour.",
  tags: ["output", "attribution", "ads", "conversions", "hourly"],
  assertions: {
    uniqueKey: ["hour_start", "source", "campaign_id", "adset_id", "ad_id"],
    nonNull: ["hour_start", "date", "source", "spend"],
  },
  bigquery: {
    clusterBy: ["source", "campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const { conversionMetrics: metrics } = require("includes/conversion_metrics");
  const { reportingTimeZone } = require("includes/reporting_time");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with ad_performance as (
  select
    hour_start,
    date,
    source,
    campaign_id,
    adset_id,
    ad_id,
    any_value(campaign_name) as campaign_name,
    any_value(adset_name) as adset_name,
    any_value(ad_name) as ad_name,
    any_value(currency) as currency,
    sum(impressions) as impressions,
    sum(clicks) as clicks,
    sum(spend) as spend
  from ${ref("mart_ad_performance_hourly")}
  group by hour_start, date, source, campaign_id, adset_id, ad_id
),

warehouse_conversions as (
  select
    timestamp_trunc(
      coalesce(session_start_timestamp, conversion_time),
      hour,
      "${reportingTimeZone}"
    ) as hour_start,
    date(
      coalesce(session_start_timestamp, conversion_time),
      "${reportingTimeZone}"
    ) as date,
    source,
    campaign_id,
    adset_id,
    ad_id,
    any_value(campaign_name) as campaign_name,
    any_value(adset_name) as adset_name,
    any_value(ad_name) as ad_name,
    ${
      metrics
        .flatMap((metric) => [
          `sum(${metric} * paid_multi_touch_weight) as ${metric}_mt`,
          `sum(${metric} * paid_first_touch_weight) as ${metric}_ft`,
          `sum(${metric} * paid_last_touch_weight) as ${metric}_lt`,
        ])
        .join(",\n    ")
    }
  from ${ref("mart_conversions_with_touchpoints")}
  where source = 'meta'
    and medium in ('cpc', 'paid', 'paid_social')
  group by hour_start, date, source, campaign_id, adset_id, ad_id
)

select
  coalesce(ads.hour_start, conversions.hour_start) as hour_start,
  coalesce(ads.date, conversions.date) as date,
  coalesce(ads.source, conversions.source) as source,
  coalesce(ads.campaign_id, conversions.campaign_id) as campaign_id,
  coalesce(ads.adset_id, conversions.adset_id) as adset_id,
  coalesce(ads.ad_id, conversions.ad_id) as ad_id,
  coalesce(ads.campaign_name, conversions.campaign_name, 'unknown') as campaign_name,
  coalesce(ads.adset_name, conversions.adset_name, 'unknown') as adset_name,
  coalesce(ads.ad_name, conversions.ad_name, 'unknown') as ad_name,
  'cpc' as medium,
  coalesce(ads.adset_name, conversions.adset_name, 'unknown') as secondary_drill_down,
  coalesce(ads.ad_name, conversions.ad_name, 'unknown') as tertiary_drill_down,
  coalesce(ads.currency, 'USD') as currency,
  coalesce(ads.impressions, 0) as impressions,
  coalesce(ads.clicks, 0) as clicks,
  coalesce(ads.spend, 0) as spend,
  ${
    metrics
      .flatMap((metric) => ["mt", "ft", "lt"].map(
        (suffix) => `coalesce(conversions.${metric}_${suffix}, 0) as ${metric}_${suffix}`
      ))
      .join(",\n  ")
  },
  safe_divide(coalesce(conversions.revenue_vip_server_side_mt, 0), nullif(ads.spend, 0)) as roas_vip_mt,
  safe_divide(coalesce(conversions.revenue_book_server_side_mt, 0), nullif(ads.spend, 0)) as roas_book_mt,
  safe_divide(coalesce(conversions.revenue_mentorship_server_side_mt, 0), nullif(ads.spend, 0)) as roas_mentorship_mt,
  safe_divide(coalesce(conversions.revenue_kajabi_server_side_mt, 0), nullif(ads.spend, 0)) as roas_kajabi_mt,
  safe_divide(coalesce(conversions.revenue_catalog_server_side_mt, 0), nullif(ads.spend, 0)) as roas_catalog_mt,
  safe_divide(coalesce(conversions.revenue_unknown_server_side_mt, 0), nullif(ads.spend, 0)) as roas_unknown_mt,
  safe_divide(coalesce(conversions.revenue_server_side_mt, 0), nullif(ads.spend, 0)) as roas_all_payments_mt
from ad_performance ads
full outer join warehouse_conversions conversions
  on ads.hour_start = conversions.hour_start
 and ads.source = conversions.source
 and ads.campaign_id is not distinct from conversions.campaign_id
 and ads.adset_id is not distinct from conversions.adset_id
 and ads.ad_id is not distinct from conversions.ad_id
