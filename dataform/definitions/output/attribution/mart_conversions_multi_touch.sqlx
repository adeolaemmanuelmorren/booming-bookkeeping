config {
  type: "table",
  description: "Daily first-, last-, and 40/20/40 multi-touch conversion metrics by acquisition dimensions.",
  tags: ["output", "attribution", "conversions"],
  bigquery: {
    clusterBy: ["source", "campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const metrics = [
    "form_submissions_server_side",
    "form_submissions_client_side",
    "order_completed_server_side",
    "order_completed_client_side",
    "payments_server_side",
    "payments_client_side",
    "revenue_server_side",
    "revenue_client_side",
    "customers_server_side",
  ];
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  date(coalesce(session_start_timestamp, conversion_time), "America/Los_Angeles") as click_date,
  source,
  medium,
  coalesce(campaign_name, 'unknown') as campaign_name,
  coalesce(adset_name, 'unknown') as adset_name,
  coalesce(ad_name, 'unknown') as ad_name,
  campaign_id,
  adset_id,
  ad_id,
  coalesce(utm_content, 'unknown') as utm_content,
  coalesce(utm_term, 'unknown') as utm_term,
  coalesce(landing_page_host, 'offline') as landing_page_host,
  coalesce(landing_page_path, 'offline') as landing_page_path,
  count(distinct session_id) as sessions,
  ${
    metrics
      .flatMap((metric) => [
        `sum(${metric} * multi_touch_weight) as ${metric}_mt`,
        `sum(${metric} * first_touch_weight) as ${metric}_ft`,
        `sum(${metric} * last_touch_weight) as ${metric}_lt`,
      ])
      .join(",\n  ")
  }
from ${ref("mart_conversions_with_touchpoints")}
group by
  click_date,
  source,
  medium,
  campaign_name,
  adset_name,
  ad_name,
  campaign_id,
  adset_id,
  ad_id,
  utm_content,
  utm_term,
  landing_page_host,
  landing_page_path
