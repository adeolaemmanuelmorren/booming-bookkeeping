config {
  type: "table",
  description: "Google and Meta spend joined to warehouse-attributed client/server conversions by click date.",
  tags: ["output", "attribution", "ads", "conversions"],
  bigquery: {
    clusterBy: ["source", "campaign_id", "adset_id", "ad_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const metrics = [
    "form_submissions_server_side",
    "form_submissions_client_side",
    "order_completed_server_side",
    "order_completed_client_side",
    "payments_server_side",
    "payments_client_side",
    "revenue_server_side",
    "revenue_client_side",
    "customers_server_side",
  ];
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with ad_performance as (
  select
    date(time, "America/Los_Angeles") as date,
    source,
    campaign_id,
    adset_id,
    ad_id,
    any_value(campaign_name) as campaign_name,
    any_value(adset_name) as adset_name,
    any_value(ad_name) as ad_name,
    any_value(currency) as currency,
    sum(impressions) as impressions,
    sum(clicks) as clicks,
    sum(unique_clicks) as unique_clicks,
    sum(unique_inline_link_clicks) as unique_inline_link_clicks,
    sum(spend) as spend,
    sum(platform_conversions) as platform_conversions,
    sum(platform_conversion_value) as platform_conversion_value
  from ${ref("mart_ad_performance")}
  group by date, source, campaign_id, adset_id, ad_id
),

warehouse_conversions as (
  select
    click_date as date,
    source,
    campaign_id,
    adset_id,
    ad_id,
    any_value(campaign_name) as campaign_name,
    any_value(adset_name) as adset_name,
    any_value(ad_name) as ad_name,
    ${
      metrics
        .flatMap((metric) => ["mt", "ft", "lt"].map(
          (suffix) => `sum(${metric}_${suffix}) as ${metric}_${suffix}`
        ))
        .join(",\n    ")
    }
  from ${ref("mart_conversions_multi_touch")}
  where source in ('google', 'meta')
    and medium in ('cpc', 'paid', 'paid_social')
  group by date, source, campaign_id, adset_id, ad_id
)

select
  coalesce(ads.date, conversions.date) as date,
  coalesce(ads.source, conversions.source) as source,
  coalesce(ads.campaign_id, conversions.campaign_id) as campaign_id,
  coalesce(ads.adset_id, conversions.adset_id) as adset_id,
  coalesce(ads.ad_id, conversions.ad_id) as ad_id,
  coalesce(ads.campaign_name, conversions.campaign_name, 'unknown') as campaign_name,
  coalesce(ads.adset_name, conversions.adset_name, 'unknown') as adset_name,
  coalesce(ads.ad_name, conversions.ad_name, 'unknown') as ad_name,
  'cpc' as medium,
  coalesce(ads.adset_name, conversions.adset_name, 'unknown') as secondary_drill_down,
  coalesce(ads.ad_name, conversions.ad_name, 'unknown') as tertiary_drill_down,
  coalesce(ads.currency, 'USD') as currency,
  coalesce(ads.impressions, 0) as impressions,
  coalesce(ads.clicks, 0) as clicks,
  coalesce(ads.unique_clicks, 0) as unique_clicks,
  coalesce(ads.unique_inline_link_clicks, 0) as unique_inline_link_clicks,
  coalesce(ads.spend, 0) as spend,
  coalesce(ads.platform_conversions, 0) as platform_conversions,
  coalesce(ads.platform_conversion_value, 0) as platform_conversion_value,
  ${
    metrics
      .flatMap((metric) => ["mt", "ft", "lt"].map(
        (suffix) => `coalesce(conversions.${metric}_${suffix}, 0) as ${metric}_${suffix}`
      ))
      .join(",\n  ")
  }
from ad_performance ads
full outer join warehouse_conversions conversions
  on ads.date = conversions.date
 and ads.source = conversions.source
 and ads.campaign_id is not distinct from conversions.campaign_id
 and ads.adset_id is not distinct from conversions.adset_id
 and ads.ad_id is not distinct from conversions.ad_id
