config {
  type: "table",
  description: "Canonical successful Stripe payments at one row per charge, with product and repeat-payment classification.",
  tags: ["output", "stripe", "payments"],
  assertions: {
    uniqueKey: ["payment_id"],
    nonNull: ["payment_id", "payment_time", "currency", "amount_paid", "product_name", "payment_occurrence_type", "is_repeat_payment"],
    rowConditions: [
      "amount_paid >= 0",
      "refund_amount >= 0",
      "net_amount = amount_paid - refund_amount",
    ],
  },
  bigquery: {
    partitionBy: "DATE(payment_time)",
    clusterBy: ["product_rule", "payment_occurrence_type", "is_repeat_payment"],
  },
}

select
  payment_id,
  payment_time,
  payment_date,
  customer_id,
  payment_email,
  payment_name,
  payment_phone,
  currency,
  amount_paid,
  refund_amount,
  net_amount,
  has_refund,
  product_id,
  product_name,
  product_variant,
  catalog_price_id as price_id,
  catalog_plan_id as plan_id,
  product_rule,
  product_classification_method,
  is_product_classified,
  payment_sequence_number,
  payment_occurrence_type,
  is_repeat_payment,
  payment_intent_id,
  payment_method_id,
  invoice_id,
  subscription_id,
  checkout_session_id,
  payment_link_id,
  invoice_billing_reason,
  checkout_mode,
  has_discount,
  discount_amount,
  discount_ids,
  coupon_ids,
  coupon_names,
  promotion_code_ids,
  promotion_codes,
  coupon_amount_off,
  coupon_percent_off,
  charge_description,
  calculated_statement_descriptor,
  statement_descriptor,
  payment_intent_description,
  invoice_description,
  book_product_text,
  receipt_url,
  livemode
from ${ref("int_stripe_payment_occurrence")}

