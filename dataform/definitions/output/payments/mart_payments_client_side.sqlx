config {
  type: "table",
  description: "Client-side payment submissions combining historical Kajabi Form Submitted rows with native Order Completed events.",
  tags: ["output", "payments", "client_side"],
  assertions: {
    uniqueKey: ["client_payment_id"],
  },
  bigquery: {
    clusterBy: ["event_source", "is_payment_confirmed"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with historical_kajabi as (
  select
    concat('historical_form_', form_submission_id) as client_payment_id,
    event_id,
    form_submission_id as source_row_id,
    'Form Submitted' as source_event_name,
    'historical_kajabi_form_submitted' as event_source,
    submitted_at as payment_time,
    profile_id,
    anonymous_id,
    user_id,
    email,
    phone,
    checkout_member_name as customer_name,
    offer_id as product_id,
    case
      when offer_id = 'v3WtGzPH' then 'Booming Bookkeeping Mentorship Program'
    end as product_name,
    cast(199 as numeric) as amount,
    'USD' as currency,
    'checkout_form_submission' as completion_basis,
    false as is_payment_confirmed,
    'submitted_unconfirmed' as payment_status,
    'historical_offer_slug' as product_amount_source,
    stripe_payment_method_id,
    payment_method_type,
    payment_provider,
    page_url,
    page_path,
    ip_address,
    user_agent,
    geo_city,
    geo_region,
    geo_country
  from ${ref("mart_form_submissions_client_side")}
  where is_checkout_form
    and offer_id = 'v3WtGzPH'
),

native_order_completed as (
  select
    concat('segment_order_', event_row_id) as client_payment_id,
    event_id,
    event_row_id as source_row_id,
    'Order Completed' as source_event_name,
    'segment_order_completed' as event_source,
    completed_at as payment_time,
    coalesce(
      email_profile.profile_id,
      anonymous_profile.profile_id
    ) as profile_id,
    orders.anonymous_id,
    orders.user_id,
    orders.email,
    orders.phone,
    orders.customer_name,
    orders.product_id,
    coalesce(orders.product_name, orders.products) as product_name,
    orders.value as amount,
    orders.currency,
    coalesce(orders.completion_basis, 'checkout_form_submission') as completion_basis,
    coalesce(orders.is_payment_confirmed, false) as is_payment_confirmed,
    coalesce(orders.payment_status, 'submitted_unconfirmed') as payment_status,
    'captured_event' as product_amount_source,
    orders.stripe_payment_method_id,
    orders.payment_method_type,
    orders.payment_provider,
    orders.page_url,
    orders.page_path,
    orders.ip_address,
    orders.user_agent,
    orders.geo_city,
    orders.geo_region,
    orders.geo_country
  from ${ref("stg_order_completed")} orders
  left join ${ref("int_identifier_profile_lookup")} email_profile
    on email_profile.identifier_type = "email"
    and email_profile.identifier_value = nullif(lower(trim(orders.email)), "")
  left join ${ref("int_identifier_profile_lookup")} anonymous_profile
    on anonymous_profile.identifier_type = "anonymous_id"
    and anonymous_profile.identifier_value = nullif(trim(orders.anonymous_id), "")
)

select * from historical_kajabi
union all
select * from native_order_completed
