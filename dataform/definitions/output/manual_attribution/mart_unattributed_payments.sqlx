config {
  type: "table",
  description: "Successful Stripe payments with no resolved profile after automatic and manual attribution.",
  tags: ["output", "manual_attribution", "payments"],
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select *
from ${ref("mart_payments")}
where profile_id is null
