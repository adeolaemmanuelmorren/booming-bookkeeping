config {
  type: "table",
  description: "Boom source records searchable when manually linking an unattributed Stripe payment to a profile.",
  tags: ["output", "manual_attribution", "profiles"],
  bigquery: {
    clusterBy: ["source_system", "is_selectable"],
  },
}

with source_rows as (
  select
    'segment_identify' as source_system,
    identify_id as source_record_id,
    identified_at as event_time,
    cast(null as string) as first_name,
    cast(null as string) as last_name,
    email,
    phone
  from ${ref("stg_identifies")}

  union all

  select
    'segment_form',
    form_submission_id,
    submitted_at,
    first_name,
    cast(null as string),
    email,
    phone
  from ${ref("stg_form_submissions_client_side")}

  union all

  select
    'activecampaign',
    contact_id,
    contact_created_at,
    first_name,
    last_name,
    email,
    phone
  from ${ref("stg_activecampaign_contacts")}
  where is_deleted is false

  union all

  select
    'stripe',
    customer_id,
    customer_created_at,
    split(name, ' ')[safe_offset(0)],
    array_reverse(split(name, ' '))[safe_offset(0)],
    email,
    phone
  from ${ref("stg_stripe_customers")}

  union all

  select
    'stripe_kajabi',
    customer_id,
    customer_created_at,
    split(name, ' ')[safe_offset(0)],
    array_reverse(split(name, ' '))[safe_offset(0)],
    email,
    phone
  from ${ref("stg_stripe_kajabi_customers")}
),

email_profiles as (
  select
    profile_id,
    email
  from ${ref("int_resolved_identifiers")}
  cross join unnest(emails) as email
),

phone_profiles as (
  select
    profile_id,
    phone
  from ${ref("int_resolved_identifiers")}
  cross join unnest(phones) as phone
),

resolved as (
  select
    source_rows.*,
    coalesce(email_profiles.profile_id, phone_profiles.profile_id) as profile_id
  from source_rows
  left join email_profiles
    on source_rows.email = email_profiles.email
  left join phone_profiles
    on regexp_replace(source_rows.phone, r'[^0-9+]', '') = phone_profiles.phone
  qualify row_number() over (
    partition by source_system, source_record_id
    order by coalesce(email_profiles.profile_id, phone_profiles.profile_id)
  ) = 1
)

select
  to_hex(md5(concat(source_system, '|', source_record_id))) as candidate_id,
  source_system,
  source_record_id,
  profile_id,
  profile_id is not null as is_selectable,
  event_time,
  first_name,
  last_name,
  nullif(trim(concat(coalesce(first_name, ''), ' ', coalesce(last_name, ''))), '') as full_name,
  email,
  phone,
  nullif(
    trim(regexp_replace(lower(concat(
      coalesce(first_name, ''), ' ',
      coalesce(last_name, ''), ' ',
      coalesce(email, ''), ' ',
      coalesce(phone, '')
    )), r'\\s+', ' ')),
    ''
  ) as search_text
from resolved
