config {
  type: "table",
  description: "One row per successful Stripe payment with automatic/manual attribution status.",
  tags: ["output", "manual_attribution", "payments"],
  bigquery: {
    clusterBy: ["payment_source", "attribution_method"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  payment_source,
  payment_id,
  payment_time,
  payment_date,
  amount_paid,
  refund_amount,
  net_amount,
  payment_email,
  payment_name,
  payment_phone,
  customer_id,
  product_name,
  product_rule,
  automatic_profile_id,
  manual_profile_id,
  profile_id,
  attribution_method,
  profile_id is not null as is_attributed,
  profile_id is null as is_unattributed
from ${ref("mart_payments")}
