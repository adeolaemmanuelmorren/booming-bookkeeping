config {
  type: "table",
  description: "Daily landing-page sessions, engagement, ad spend, and separate client/server conversion measures.",
  tags: ["output", "landing_pages", "attribution"],
  bigquery: {
    clusterBy: ["landing_page_host_normalized", "landing_page_path"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
  const metrics = [
    "form_submissions_server_side",
    "form_submissions_client_side",
    "order_completed_server_side",
    "order_completed_client_side",
    "payments_server_side",
    "payments_client_side",
    "revenue_server_side",
    "revenue_client_side",
    "customers_server_side",
  ];
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with session_engagement as (
  select
    date(session_start_timestamp, "America/Los_Angeles") as date,
    coalesce(nullif(lower(trim(first_page_host)), ''), 'unknown') as landing_page_host,
    regexp_replace(coalesce(nullif(lower(trim(first_page_host)), ''), 'unknown'), r'^www\.', '')
      as landing_page_host_normalized,
    coalesce(nullif(trim(first_page_path), ''), '/') as landing_page_path,
    count(*) as sessions,
    sum(page_view_count) as total_page_views,
    avg(page_view_count) as average_pages_per_session,
    avg(session_duration_seconds) as average_session_duration_seconds,
    countif(page_view_count = 1) as bounce_sessions,
    countif(page_view_count > 1 or session_duration_seconds >= 10) as engaged_sessions
  from ${ref("mart_sessions")}
  group by date, landing_page_host, landing_page_host_normalized, landing_page_path
),

conversions as (
  select
    click_date as date,
    coalesce(nullif(lower(trim(landing_page_host)), ''), 'unknown') as landing_page_host,
    regexp_replace(coalesce(nullif(lower(trim(landing_page_host)), ''), 'unknown'), r'^www\.', '')
      as landing_page_host_normalized,
    coalesce(nullif(trim(landing_page_path), ''), '/') as landing_page_path,
    ${
      metrics
        .flatMap((metric) => ["mt", "ft", "lt"].map(
          (suffix) => `sum(${metric}_${suffix}) as ${metric}_${suffix}`
        ))
        .join(",\n    ")
    }
  from ${ref("mart_conversions_multi_touch_pages")}
  group by date, landing_page_host, landing_page_host_normalized, landing_page_path
),

ad_spend as (
  select
    date,
    any_value(landing_page_host) as landing_page_host,
    landing_page_host_normalized,
    landing_page_path,
    sum(impressions) as ad_impressions,
    sum(unique_clicks) as ad_clicks,
    sum(spend) as ad_spend
  from ${ref("mart_ad_cost_by_landing_page_daily")}
  where has_landing_page_url
  group by date, landing_page_host_normalized, landing_page_path
),

combined as (
  select
    coalesce(sessions.date, conversions.date, ad_spend.date) as date,
    coalesce(sessions.landing_page_host, conversions.landing_page_host, ad_spend.landing_page_host, 'unknown')
      as landing_page_host,
    coalesce(
      sessions.landing_page_host_normalized,
      conversions.landing_page_host_normalized,
      ad_spend.landing_page_host_normalized,
      'unknown'
    ) as landing_page_host_normalized,
    coalesce(sessions.landing_page_path, conversions.landing_page_path, ad_spend.landing_page_path, '/')
      as landing_page_path,
    sessions.sessions,
    sessions.total_page_views,
    sessions.average_pages_per_session,
    sessions.average_session_duration_seconds,
    sessions.bounce_sessions,
    sessions.engaged_sessions,
    ad_spend.ad_impressions,
    ad_spend.ad_clicks,
    ad_spend.ad_spend,
    ${
      metrics
        .flatMap((metric) => ["mt", "ft", "lt"].map(
          (suffix) => `conversions.${metric}_${suffix}`
        ))
        .join(",\n    ")
    }
  from session_engagement sessions
  full outer join conversions
    on sessions.date = conversions.date
   and sessions.landing_page_host_normalized = conversions.landing_page_host_normalized
   and sessions.landing_page_path = conversions.landing_page_path
  full outer join ad_spend
    on coalesce(sessions.date, conversions.date) = ad_spend.date
   and coalesce(sessions.landing_page_host_normalized, conversions.landing_page_host_normalized)
     = ad_spend.landing_page_host_normalized
   and coalesce(sessions.landing_page_path, conversions.landing_page_path) = ad_spend.landing_page_path
)

select
  date,
  landing_page_host,
  landing_page_host_normalized,
  landing_page_path,
  concat(landing_page_host_normalized, landing_page_path) as landing_page,
  coalesce(sessions, 0) as sessions,
  coalesce(total_page_views, 0) as total_page_views,
  coalesce(average_pages_per_session, 0) as average_pages_per_session,
  coalesce(average_session_duration_seconds, 0) as average_session_duration_seconds,
  coalesce(bounce_sessions, 0) as bounce_sessions,
  safe_divide(coalesce(bounce_sessions, 0), nullif(coalesce(sessions, 0), 0)) as bounce_rate,
  coalesce(engaged_sessions, 0) as engaged_sessions,
  safe_divide(coalesce(engaged_sessions, 0), nullif(coalesce(sessions, 0), 0)) as engagement_rate,
  coalesce(ad_impressions, 0) as ad_impressions,
  coalesce(ad_clicks, 0) as ad_clicks,
  coalesce(ad_spend, 0) as ad_spend,
  ${
    metrics
      .flatMap((metric) => ["mt", "ft", "lt"].map(
        (suffix) => `coalesce(${metric}_${suffix}, 0) as ${metric}_${suffix}`
      ))
      .join(",\n  ")
  },
  coalesce(revenue_server_side_mt, 0) - coalesce(ad_spend, 0) as server_side_profit,
  safe_divide(
    coalesce(order_completed_server_side_mt, 0),
    nullif(coalesce(form_submissions_server_side_mt, 0), 0)
  ) as server_side_form_to_order_rate
from combined
