config {
  type: "table",
  description: "Server-side form submissions from configured ActiveCampaign tag assignments.",
  tags: ["output", "funnel", "forms", "server_side"],
  assertions: {
    uniqueKey: ["form_submission_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


with email_profiles as (
  select
    profile_id,
    email
  from ${ref("int_resolved_identifiers")}
  cross join unnest(emails) as email
),

phone_profiles as (
  select
    profile_id,
    phone
  from ${ref("int_resolved_identifiers")}
  cross join unnest(phones) as phone
)

select
  forms.*,
  coalesce(email_profiles.profile_id, phone_profiles.profile_id) as profile_id
from ${ref("int_activecampaign_form_submissions")} forms
left join email_profiles
  on forms.email = email_profiles.email
left join phone_profiles
  on regexp_replace(forms.phone, r'[^0-9+]', '') = phone_profiles.phone
qualify row_number() over (
  partition by forms.form_submission_id
  order by coalesce(email_profiles.profile_id, phone_profiles.profile_id)
) = 1
