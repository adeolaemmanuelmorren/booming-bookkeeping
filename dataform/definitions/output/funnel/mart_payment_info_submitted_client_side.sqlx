config {
  type: "table",
  description: "Client-side checkout-form submissions, separate from confirmed payments.",
  tags: ["output", "funnel", "checkout", "client_side"],
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select *
from ${ref("mart_form_submissions_client_side")}
where is_checkout_form
