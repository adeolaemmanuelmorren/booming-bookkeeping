config {
  type: "table",
  description: "All client-side Segment form submissions, retaining lead-versus-checkout classification.",
  tags: ["output", "funnel", "forms", "client_side"],
  assertions: {
    uniqueKey: ["form_submission_id"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  forms.*,
  coalesce(
    email_profile.profile_id,
    phone_profile.profile_id,
    anonymous_profile.profile_id
  ) as profile_id
from ${ref("stg_form_submissions_client_side")} forms
left join ${ref("int_identifier_profile_lookup")} email_profile
  on email_profile.identifier_type = "email"
  and email_profile.identifier_value = nullif(lower(trim(forms.email)), "")
left join ${ref("int_identifier_profile_lookup")} phone_profile
  on phone_profile.identifier_type = "phone"
  and phone_profile.identifier_value = nullif(
    regexp_replace(forms.phone, r"[^0-9+]", ""),
    ""
  )
left join ${ref("int_identifier_profile_lookup")} anonymous_profile
  on anonymous_profile.identifier_type = "anonymous_id"
  and anonymous_profile.identifier_value = nullif(trim(forms.anonymous_id), "")
