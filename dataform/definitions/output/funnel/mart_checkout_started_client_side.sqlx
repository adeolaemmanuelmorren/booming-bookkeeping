config {
  type: "table",
  description: "First qualifying checkout-page view per session and offer.",
  tags: ["output", "funnel", "checkout", "client_side"],
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  to_hex(md5(concat(session_id, '|', coalesce(first_page_path, '')))) as checkout_started_id,
  session_id,
  profile_id,
  anonymous_id,
  user_id,
  session_start_timestamp as checkout_started_at,
  first_page_url as checkout_url,
  first_page_path as checkout_path,
  regexp_extract(first_page_path, r'(?i)/offers/([^/]+)/checkout') as offer_id,
  channel_source,
  channel_medium,
  campaign_id,
  adset_id,
  ad_id,
  gclid,
  gbraid,
  wbraid,
  fbclid,
  ttclid
from ${ref("mart_touchpoints_all")}
where regexp_contains(lower(coalesce(first_page_path, '')), r'/checkout|/order|/offers/[^/]+/checkout')
qualify row_number() over (
  partition by session_id, coalesce(regexp_extract(first_page_path, r'(?i)/offers/([^/]+)/checkout'), first_page_path)
  order by session_start_timestamp
) = 1
