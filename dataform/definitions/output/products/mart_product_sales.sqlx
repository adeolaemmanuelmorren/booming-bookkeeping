config {
  type: "table",
  description: "Stripe product sales summarized by source, rule, occurrence type, and local payment date.",
  tags: ["output", "products", "payments"],
  bigquery: {
    clusterBy: ["payment_source", "product_rule"],
  },
}

js {
  const { dropPartitionedTableOnce } = require("includes/table_migrations");
}

pre_operations {
  ${dropPartitionedTableOnce(self())}
}


select
  payment_date,
  payment_source,
  product_rule,
  product_id,
  product_name,
  product_variant,
  payment_occurrence_type,
  is_repeat_payment,
  count(*) as payments,
  count(distinct customer_id) as customers,
  sum(amount_paid) as gross_revenue,
  sum(refund_amount) as refunds,
  sum(net_amount) as net_revenue
from ${ref("mart_payments")}
group by
  payment_date,
  payment_source,
  product_rule,
  product_id,
  product_name,
  product_variant,
  payment_occurrence_type,
  is_repeat_payment
